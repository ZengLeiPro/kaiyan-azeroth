{
  "name": "ky-azeroth",
  "version": "0.1.0",
  "private": true,
  "description": "Azeroth",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ky-azeroth/web",
    "dev:server": "turbo run dev --filter=@ky-azeroth/server",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@ky-azeroth/web",
    "build:server": "turbo run build --filter=@ky-azeroth/server",
    "test": "turbo run test",
    "test:linux": "docker compose -f docker-compose.test.yml run --rm app",
    "test:gates": "node --test --test-concurrency=1 scripts/check-*.test.js",
    "test:cov": "turbo run test:cov",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:local": "node scripts/prepare-test-db.js",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "turbo run db:generate --filter=@ky-azeroth/server",
    "db:migrate": "turbo run db:migrate --filter=@ky-azeroth/server",
    "db:seed": "turbo run db:seed --filter=@ky-azeroth/server",
    "db:studio": "turbo run db:studio --filter=@ky-azeroth/server",
    "db:reset": "pnpm --filter @ky-azeroth/server exec prisma migrate reset",
    "prepare": "husky",
    "check:shared": "node scripts/check-shared-imports.js",
    "check:dto": "node scripts/check-dto-implements.js",
    "check:query-dto": "node scripts/check-query-dto.js",
    "check:decimal": "node scripts/check-decimal.js",
    "check:decimal-precision": "node scripts/check-decimal-precision.js",
    "check:no-any": "node scripts/check-no-any.js",
    "check:no-double-assertion": "node scripts/check-no-double-assertion.js",
    "check:optional": "node scripts/check-optional.js",
    "check:usecrud": "node scripts/check-usecrud-schema.js",
    "check:transform": "node scripts/check-transform-completeness.js",
    "check:prisma-coverage": "node scripts/check-prisma-coverage.js",
    "check:controller-query-dto": "node scripts/check-controller-query-dto.js",
    "check:controller-body-dto": "node scripts/check-controller-body-dto.js",
    "check:no-inline-dto-schema": "node scripts/check-no-inline-dto-schema.js",
    "check:controller-return-type": "node scripts/check-controller-return-type.js",
    "check:ui-layering": "node scripts/check-ui-layering.js",
    "check:json-helpers": "node scripts/check-json-helpers.js",
    "check:seed-no-raw-sql": "node scripts/check-seed-no-raw-sql.js",
    "check:no-loose-sql": "node scripts/check-no-loose-sql.js",
    "check:expand-only-migrations": "node scripts/check-expand-only-migrations.js",
    "check:ts-expect-error": "node scripts/check-ts-expect-error.js",
    "check:query-schema-pagination": "node scripts/check-query-schema-pagination.js",
    "check:manual-validation": "node scripts/check-manual-validation.js",
    "check:no-prisma-web": "node scripts/check-no-prisma-client-in-web.js",
    "check:service-raw-sql": "node scripts/check-service-raw-sql-comment.js",
    "check:jwt-guard": "node scripts/check-jwt-guard.js",
    "check:route-authorization": "node scripts/check-route-authorization-metadata.js",
    "check:web-route-authorization": "node scripts/check-web-route-authorization.js",
    "check:controller-route-naming": "node scripts/check-controller-route-naming.js",
    "check:helmet": "node scripts/check-helmet-enabled.js",
    "check:response-sensitive": "node scripts/check-response-no-sensitive-fields.js",
    "check:no-production-console": "node scripts/check-no-production-console.js",
    "check:finance-import-batch-ssot": "node scripts/check-finance-import-batch-ssot.js",
    "check:optimistic-lock": "node scripts/check-optimistic-lock.js",
    "check:no-business-cascade": "node scripts/check-no-business-cascade.js",
    "check:fk-index": "node scripts/check-fk-index.js",
    "check:audit-fields": "node scripts/check-audit-fields.js",
    "check:prisma-config": "node scripts/check-prisma-config.js",
    "check:production-env-mapping": "node scripts/check-production-env-mapping.js",
    "check:meta-consistency": "node scripts/check-meta-consistency.js",
    "check:display-name": "node scripts/check-display-name.js",
    "audit:crm-manager-finance": "node scripts/audit-crm-manager-finance-permissions.js --confirm-read-only-role",
    "check:all": "STRICT=1 pnpm run check:shared && pnpm run check:dto && pnpm run check:query-dto && pnpm run check:decimal && pnpm run check:decimal-precision && pnpm run check:no-any && pnpm run check:no-double-assertion && pnpm run check:optional && pnpm run check:usecrud && pnpm run check:transform && pnpm run check:controller-query-dto && pnpm run check:controller-body-dto && pnpm run check:no-inline-dto-schema && STRICT=1 pnpm run check:prisma-coverage && STRICT=1 pnpm run check:controller-return-type && pnpm run check:json-helpers && pnpm run check:seed-no-raw-sql && pnpm run check:no-loose-sql && pnpm run check:expand-only-migrations && pnpm run check:ts-expect-error && pnpm run check:query-schema-pagination && pnpm run check:manual-validation && pnpm run check:ui-layering && pnpm run check:no-prisma-web && pnpm run check:service-raw-sql && pnpm run check:jwt-guard && pnpm run check:route-authorization && pnpm run check:web-route-authorization && pnpm run check:controller-route-naming && pnpm run check:helmet && pnpm run check:response-sensitive && pnpm run check:no-production-console && pnpm run check:finance-import-batch-ssot && pnpm run check:optimistic-lock && pnpm run check:no-business-cascade && pnpm run check:fk-index && pnpm run check:audit-fields && pnpm run check:prisma-config && pnpm run check:production-env-mapping && pnpm run check:permission-menu && pnpm run check:cli-capabilities && pnpm run check:meta-consistency && pnpm run check:cli-doctor && pnpm run check:display-name && pnpm run test:gates && pnpm --filter @ky-azeroth/server exec prisma validate",
    "check:cli-doctor": "node scripts/check-cli-doctor.js",
    "check:permission-menu": "node scripts/check-permission-menu-consistency.js",
    "check:cli-capabilities": "node scripts/check-cli-capabilities.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.9.14",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.17.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "bash -c 'cd apps/web && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "apps/server/src/**/*.ts": [
      "bash -c 'cd apps/server && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "packages/shared/src/**/*.ts": [
      "bash -c 'cd packages/shared && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
