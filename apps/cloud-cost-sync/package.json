{
  "name": "@ky-azeroth/cloud-cost-sync",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync": "tsx src/index.ts",
    "sync:local": "tsx src/index.ts",
    "sync:dry": "tsx src/index.ts --dry-run",
    "db:generate": "prisma generate",
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*/__tests__/*.test.ts"
  },
  "dependencies": {
    "@alicloud/bssopenapi20171214": "^4.1.0",
    "@alicloud/cms20190101": "^2.0.0",
