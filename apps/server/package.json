{
  "name": "@ky-azeroth/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/bundle-cli.mjs",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "validate:schema": "node ../../scripts/validate-schema.js",
    "db:migrate": "prisma migrate dev && pnpm validate:schema",
    "db:migrate:prod": "prisma migrate deploy",
    "deploy": "pnpm db:migrate:prod",
    "db:seed": "prisma db seed",
    "seed:approval-flows-defaults": "tsx prisma/seeds/run-approval-flows-defaults.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "clean": "rm -rf dist",
    "precommit": "pnpm validate:schema && pnpm typecheck",
    "test:cov:baseline": "node scripts/check-coverage-baseline.mjs",
    "test:cov:changed": "node scripts/check-changed-coverage.mjs",
    "test:cov:modules": "node scripts/check-module-coverage-baseline.mjs"
  },
  "dependencies": {
    "@ky-azeroth/shared": "file:../../packages/shared",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.19.2",
    "@types/mime-types": "^3.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "mime-types": "^3.0.2",
    "nestjs-zod": "^5.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "bowser": "^2.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.2.3",
    "esbuild": "0.27.2",
    "eslint": "^10.10.0",
    "globals": "^16.0.0",
    "run-script-webpack-plugin": "^0.2.3",
    "supertest": "^6.3.4",
    "ts-loader": "^9.5.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^5.0.0",
    "webpack": "^5.105.2",
    "webpack-node-externals": "^3.0.0"
  }
}
