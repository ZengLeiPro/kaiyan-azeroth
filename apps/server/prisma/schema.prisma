  ownerCategory String? @db.VarChar(30)
  /// 归属名称（客户名 / 内部模块名）
  ownerName     String? @db.VarChar(100)
  /// 续费意愿：auto / manual / cancel / undecided
  renewalIntent String? @db.VarChar(20)
  /// 备注
  notes         String?
  /// 已归档（不再出现在主表）
  archived      Boolean @default(false)

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  version   Int       @default(1)

  @@unique([vendor, productCode, instanceId], name: "uniq_instance_meta")
  @@index([vendor, productCode])
  @@index([ownerCategory])
  @@index([renewalIntent])
  @@index([archived])
  @@map("cloud_instance_metas")
  @@schema("public")
}

/// 云成本预警事件
model CloudAlert {
  id              String    @id @default(uuid())
  triggeredAt     DateTime  @default(now())
  vendor          String    @default("aliyun") @db.VarChar(20)
  /// p0 / p1 / p2
  level           String    @db.VarChar(10)
  /// balance_low / package_low / package_expiring / subscription_expiring / spike_anomaly / usage_anomaly / package_runout_early
  category        String    @db.VarChar(30)
  title           String    @db.VarChar(200)
  message         String
  /// 触发数据快照
  payload         Json?
  /// 关联资源（实例 ID / 资源包 ID / 产品代码）
  relatedResource String?   @db.VarChar(300)
  /// active / resolved / dismissed
  status          String    @default("active") @db.VarChar(20)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNote  String?

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([triggeredAt])
  @@index([level])
  @@index([category])
  @@index([status])
  @@index([status, level, triggeredAt])
  @@map("cloud_alerts")
  @@schema("public")
}

// ============ SEO 监测（只 ADMIN 可见） ============
// 由 seo-sync FC 每日定时拉取 Bing Webmaster + Microsoft Clarity + 百度统计 OpenAPI 数据写入；
// 前端聚合展示。仅 ADMIN 角色可见与编辑。
// 设计参照 cloud_* 系列；rawPayload Json? 兜底原始响应。

/// SEO 关键词查询统计（按 site + 日期 + 查询词 唯一）
/// 数据源：Bing Webmaster Tools /GetQueryStats（每日累计），未来可扩展百度站长
model SeoSearchQuery {
  id          String   @id @default(uuid())
  /// 数据日期（YYYY-MM-DD，按 UTC+8）
  statDate    DateTime @db.Date
  /// 数据源：bing / baidu / bing-ai / baidu-suggest 等
  source      String   @default("bing") @db.VarChar(20)
  /// 站点 URL（一般是 https://www.example.com）
  siteUrl     String   @db.VarChar(200)
  /// 搜索词
  query       String   @db.VarChar(500)
  /// 点击数
  clicks      Int      @default(0)
  /// 曝光数
  impressions Int      @default(0)
  /// 平均排名（小数）
  /// @precision Decimal
  avgPosition Decimal? @db.Decimal(6, 2)
  /// 点击率 0-1
  /// @precision Decimal
  ctr         Decimal? @db.Decimal(6, 4)
  /// 原始响应（调试 / 后续字段扩展用）
  rawPayload  Json?

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  version   Int       @default(1)

  @@unique([source, siteUrl, statDate, query], name: "uniq_seo_search_query")
  @@index([statDate])
  @@index([source, statDate])
  @@index([siteUrl, statDate])
  @@map("seo_search_queries")
  @@schema("public")
}

/// SEO 搜索表现权威聚合（Google Search Console site/page 维度）
/// query 维度会因 GSC 匿名化而少于整站总量，故总 KPI 与页面排行必须读本表。
model SeoSearchPerformance {
  id             String   @id @default(uuid())
  /// 数据日期（YYYY-MM-DD，按 UTC+8）
  statDate       DateTime @db.Date
  /// 数据源：当前为 google
  source         String   @default("google") @db.VarChar(20)
  /// 展示用站点 URL（一般是 https://www.example.com）
  siteUrl        String   @db.VarChar(200)
  /// 聚合维度：site / page
  dimension      String   @db.VarChar(20)
  /// site 使用 __SITE__；page 使用 GSC 返回的完整 URL
  dimensionValue String   @db.VarChar(500)
  clicks         Int      @default(0)
  impressions    Int      @default(0)
  /// @precision Decimal
  avgPosition    Decimal? @db.Decimal(6, 2)
  /// 点击率 0-1
  /// @precision Decimal
  ctr            Decimal? @db.Decimal(6, 4)
  rawPayload     Json?

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  version   Int       @default(1)

  @@unique([source, siteUrl, statDate, dimension, dimensionValue], name: "uniq_seo_search_performance", map: "seo_search_performances_source_siteUrl_statDate_dimension_dimen")
  @@index([statDate])
  @@index([source, dimension, statDate])
  @@index([siteUrl, dimension, statDate])
  @@map("seo_search_performances")
  @@schema("public")
}

/// SEO 页面级洞察（按 site + 日期 + URL 唯一）
/// 数据源：Microsoft Clarity Data Export API（live-insights），近 3 日窗口
/// API 限制：每项目每日 10 次调用，1000 sessions / 调用
model SeoPageInsight {
  id              String   @id @default(uuid())
  /// 数据日期（YYYY-MM-DD）
  statDate        DateTime @db.Date
  /// 数据源：clarity（未来可扩 baidu-tongji 页面统计）
  source          String   @default("clarity") @db.VarChar(20)
  /// 站点 URL
  siteUrl         String   @db.VarChar(200)
  /// 页面 URL（相对路径，如 /about/ 或 / ）
  pageUrl         String   @db.VarChar(500)
  /// 该页 sessions 数
  sessions        Int      @default(0)
  /// 唯一访客数
  uniqueUsers     Int      @default(0)
  /// 总浏览页数
  pageViews       Int      @default(0)
  /// 平均停留秒数
  avgEngagementMs Int?
  /// 滚动深度 0-100
  scrollDepthAvg  Int?
  /// 死点击次数
  deadClicks      Int      @default(0)
  /// 暴怒点击次数
  rageClicks      Int      @default(0)
  /// 快速回退次数（5 秒内离开）
  quickbacks      Int      @default(0)
  /// 过度滚动次数
  excessiveScroll Int      @default(0)
  /// JS 错误次数
  jsErrors        Int      @default(0)
  /// 原始响应
  rawPayload      Json?

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  version   Int       @default(1)

  @@unique([source, siteUrl, statDate, pageUrl], name: "uniq_seo_page_insight")
  @@index([statDate])
  @@index([source, statDate])
  @@index([siteUrl, statDate])
  @@map("seo_page_insights")
  @@schema("public")
}

/// SEO 整站流量快照（按 site + 日期 唯一）
/// 数据源：百度统计 OpenAPI（待 PV>100 开通后启用，schema 先就位）/ 未来可聚合 Bing+Clarity
model SeoTrafficSnapshot {
  id              String   @id @default(uuid())
  /// 数据日期（YYYY-MM-DD）
  statDate        DateTime @db.Date
  /// 数据源：baidu-tongji / clarity-aggregate / mixed
  source          String   @default("baidu-tongji") @db.VarChar(20)
  /// 站点 URL
  siteUrl         String   @db.VarChar(200)
  /// 页面浏览量
  pv              Int      @default(0)
  /// 独立访客数
  uv              Int      @default(0)
  /// 独立 IP 数
  ip              Int      @default(0)
  /// 访问次数（session 数）
  visitCount      Int      @default(0)
  /// 跳出率 0-1
  /// @precision Decimal
  bounceRate      Decimal? @db.Decimal(6, 4)
  /// 平均访问时长（秒）
  avgVisitTime    Int?
  /// 平均访问页数
  /// @precision Decimal
  avgVisitPages   Decimal? @db.Decimal(6, 2)
  /// 新访客数
  newVisitor      Int      @default(0)
  /// 来源细分 [{type: 'search', name: '百度', visits: 12}, ...]
  sourceBreakdown Json     @default("[]")
  /// 原始响应
  rawPayload      Json?

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  version   Int       @default(1)

  @@unique([source, siteUrl, statDate], name: "uniq_seo_traffic_snapshot")
  @@index([statDate])
  @@index([source, statDate])
  @@index([siteUrl, statDate])
  @@map("seo_traffic_snapshots")
  @@schema("public")
}

/// SEO 同步任务执行记录
/// 每次 FC 运行都落一条；失败或部分成功时人可查看 errors 字段定位问题
model SeoSyncRun {
  id            String    @id @default(uuid())
  /// 触发源：timer / http
  triggerSource String    @db.VarChar(20)
  /// 状态：running / success / partial / failed
  status        String    @default("running") @db.VarChar(20)
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  /// 总耗时毫秒
  elapsedMs     Int?
  /// 各源同步成功条数 {bing: 12, clarity: 8, baiduTongji: 0}
  counts        Json      @default("{}")
  /// 错误清单 [{source, stage, message}]
  errors        Json      @default("[]")
  /// 完整运行报告（开发调试用）
  report        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@index([startedAt])
  @@index([status])
  @@index([status, startedAt])
  @@map("seo_sync_runs")
  @@schema("public")
}

// ========================================
// 小红书聚光 OAuth 与数据分析
// ========================================

model XiaohongshuOauthState {
  id         String    @id @default(uuid())
  stateHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  version   Int       @default(1)

  @@index([expiresAt])
  @@index([consumedAt])
  @@map("xiaohongshu_oauth_states")
  @@schema("public")
}

model XiaohongshuConnection {
  id                     String    @id @default(uuid())
  appId                  String    @db.VarChar(50)
  userId                 String    @db.VarChar(128)
  roleType               Int
  approvalRoleType       Int?
  platformType           Int
  scopes                 Json      @default("[]")
  accessTokenCiphertext  String    @db.Text
  refreshTokenCiphertext String    @db.Text
  accessTokenExpiresAt   DateTime
  refreshTokenExpiresAt  DateTime
  status                 String    @default("active") @db.VarChar(20)
  lastRefreshedAt        DateTime  @default(now())
  lastSyncedAt           DateTime?
  lastError              String?   @db.Text
  refreshLeaseId         String?   @db.VarChar(64)
  refreshLeaseUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  version   Int       @default(1)

  advertisers XiaohongshuAdvertiser[]
  syncRuns    XiaohongshuSyncRun[]

  @@unique([appId, userId], name: "uniq_xiaohongshu_connection")
  @@index([status])
  @@index([refreshTokenExpiresAt])
  @@index([refreshLeaseUntil])
  @@map("xiaohongshu_connections")
  @@schema("public")
}

model XiaohongshuAdvertiser {
  id              String    @id @default(uuid())
  connectionId    String
  advertiserId    String    @db.VarChar(50)
  advertiserName  String    @db.VarChar(200)
  corporationName String?   @db.VarChar(200)
  virtualSellerId String?   @db.VarChar(128)
  status          String    @default("active") @db.VarChar(20)
  lastSyncedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  version   Int       @default(1)

  connection XiaohongshuConnection    @relation(fields: [connectionId], references: [id])
  reports    XiaohongshuDailyReport[]

  @@unique([connectionId, advertiserId], name: "uniq_xiaohongshu_advertiser")
  @@index([connectionId])
  @@index([advertiserId])
  @@index([status])
  @@map("xiaohongshu_advertisers")
  @@schema("public")
}

model XiaohongshuDailyReport {
