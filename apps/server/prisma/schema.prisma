  updaterEmployee Employee?    @relation("ApprovalFlowNodeUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@unique([flowId, nodeOrder])
  @@index([flowId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("approval_flow_nodes")
  @@schema("public")
}

/// 审批实例
model ApprovalInstance {
  id                String    @id @default(uuid())
  code              String    @unique @db.VarChar(50)
  flowId            String
  flowVersion       Int
  eventType         String    @db.VarChar(50)
  formId            String
  formCode          String    @db.VarChar(50)
  /// 提交时业务目标的精确 version；legacy NULL 终态操作必须 fail-closed。
  targetVersion     Int?
  title             String    @db.VarChar(200)
  status            String    @default("pending") @db.VarChar(20)
  currentNode       Int       @default(1)
  totalNodes        Int
  initiatorId       String
  initiatorName     String    @db.VarChar(50)
  copyToIds         String[]  @default([])
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  flow            ApprovalFlow           @relation(fields: [flowId], references: [id])
  tasks           ApprovalTask[]
  records         ApprovalRecord[]
  changeRequest   ApprovalChangeRequest? @relation("ApprovalChangeRequestInstance")
  creatorEmployee Employee?              @relation("ApprovalInstanceCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?              @relation("ApprovalInstanceUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  // 历史曾用 @@unique([eventType, formId])（全状态硬唯一），导致驳回/撤回后再次提单
  // 撞 DB 层 P2002（哪怕老实例已经 rejected/withdrawn）。2026-06 改造为 partial unique
  // (WHERE status='pending')，只阻止"同一表单同时有两个 pending 实例"。Prisma schema
  // 无法表达 partial unique，partial 索引由 migration 20260615231500_approval_instance_partial_unique
  // 直接 raw SQL 创建（CREATE UNIQUE INDEX ... WHERE status='pending'）。
  // 应用层 createApprovalInstance 内 status='pending' 的 findFirst 守卫仍保留，作为双保险。
  @@index([eventType, formId])
  @@index([flowId])
  @@index([initiatorId])
  @@index([status])
  @@index([status, createdAt])
  @@index([initiatorId, status])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("approval_instances")
  @@schema("public")
}

/// 审批变更申请：已通过单据的修改先进入此表，审批通过后再应用到业务表
/// 同一 (targetType,targetId) 最多一条 status='pending' 且 deletedAt IS NULL 的记录，
/// 由 contract-migrations/20260824115000_approval_change_request_pending_unique 的 partial UNIQUE 强制；
/// Prisma schema 当前不能表达 partial UNIQUE，禁止用普通 @@unique 替代。
model ApprovalChangeRequest {
  id                 String    @id @default(uuid())
  eventType          String    @db.VarChar(50)
  targetType         String    @db.VarChar(50)
  targetId           String
  targetCode         String?   @db.VarChar(100)
  title              String    @db.VarChar(200)
  baseVersion        Int
  patch              Json
  beforeSnapshot     Json
  afterSnapshot      Json
  status             String    @default("pending") @db.VarChar(20)
  approvalInstanceId String?   @unique
  appliedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  version            Int       @default(1)
  creatorEmployeeId  String?
  updaterEmployeeId  String?

  approvalInstance ApprovalInstance? @relation("ApprovalChangeRequestInstance", fields: [approvalInstanceId], references: [id], onDelete: SetNull)
  creatorEmployee  Employee?         @relation("ApprovalChangeRequestCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee  Employee?         @relation("ApprovalChangeRequestUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, status])
  @@index([eventType, status])
  @@index([approvalInstanceId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("approval_change_requests")
  @@schema("public")
}

