// ============ 训练记录表（应用层已于 2026-09-14 移除） ============
// 同样只保留 schema 以满足 expand-only；DROP 走独立 contract-migrations。

/// 动作字典（预置 + 用户可加私有动作）
model ExerciseLibrary {
  id     String  @id @default(uuid())
  /// 英文唯一 slug，预置动作稳定不变（如 hack-squat / arnold-press）
  slug   String  @unique @db.VarChar(80)
  name   String  @db.VarChar(60)
  nameEn String? @db.VarChar(60)

  /// 主肌群（chest / back_lats / back_upper / shoulders / arms_biceps / arms_triceps / legs_quads / legs_hamstrings / legs_glutes / core / cardio）
  primaryMuscleGroup    String   @db.VarChar(30)
  secondaryMuscleGroups String[] @default([]) @db.VarChar(30)
  /// 器械（barbell / dumbbell / machine / cable / smith / bodyweight / band / kettlebell / bench / outdoor）
  equipment             String   @db.VarChar(30)
  /// compound / isolation / cardio
  movementType          String   @db.VarChar(20)
  /// push / pull / squat / hinge / lunge / carry / rotation / anti_rotation / cardio / isolation
  mechanics             String   @db.VarChar(20)
  isUnilateral          Boolean  @default(false)

  /// 是否系统预置：true = seed 不可编辑/删除；false = 用户加的私有动作
  isPreset Boolean  @default(false)
  /// 系统 seed 为 null；用户加的填 user.employeeId
  ownerId  String?
  tags     String[] @default([]) @db.VarChar(30)
  notes    String?
  isActive Boolean  @default(true)

  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  creatorEmployee  Employee?         @relation("ExerciseLibraryCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee  Employee?         @relation("ExerciseLibraryUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]

  @@index([primaryMuscleGroup, isActive, deletedAt])
  @@index([equipment])
  @@index([ownerId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("exercise_library")
  @@schema("public")
}

/// 训练 Session 主表（一次训练 = 一条）
model WorkoutSession {
  id        String  @id @default(uuid())
  ownerId   String
  ownerName String? @db.VarChar(50)

  sessionDate DateTime  @db.Date
  startedAt   DateTime
  endedAt     DateTime?
  /// 训练时长（分钟）；优先由 endedAt - startedAt 计算，允许手填覆盖
  durationMin Int?

  /// 训练类型：coach（教练课）/ home（家练）/ gym_self（自训）/ zone2（有氧）
  sessionType String  @default("coach") @db.VarChar(20)
  coachName   String? @db.VarChar(30)
  location    String? @db.VarChar(50)

  /// 录入时的体重快照，抓 BodyMetric 最新一条默认填，可手改
  /// @precision Decimal
  bodyweightKg Decimal? @db.Decimal(5, 2)
  /// 整场 RPE 0-10
  /// @precision Decimal
  sessionRpe   Decimal? @db.Decimal(3, 1)
  /// good / normal / off
  feelingTag   String?  @db.VarChar(20)

  /// 衍生汇总（service 在事务里算好回填）
  totalSets     Int     @default(0)
  /// @precision Decimal
  totalVolumeKg Decimal @default(0) @db.Decimal(10, 2)
  workMinutes   Int?
  /// 本次打破的 PR 数（service 计算）
  prCount       Int     @default(0)

  notes String?

  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  exercises       WorkoutExercise[]
  creatorEmployee Employee?         @relation("WorkoutSessionCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?         @relation("WorkoutSessionUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([ownerId, sessionDate, deletedAt])
  @@index([ownerId, sessionType])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("workout_sessions")
  @@schema("public")
}

/// 训练动作子表（一个 Session 包含 N 个动作，每个动作有快照字段）
model WorkoutExercise {
  id         String  @id @default(uuid())
  sessionId  String
  /// 可空：支持 ad-hoc 动作不入字典
  exerciseId String?
  sortOrder  Int     @default(0)

  /// 快照（从字典 freeze，即使字典改/删也不影响历史）
  nameSnapshot               String  @db.VarChar(60)
  primaryMuscleGroupSnapshot String  @db.VarChar(30)
  equipmentSnapshot          String  @db.VarChar(30)
  isUnilateralSnapshot       Boolean @default(false)

  notes String?

  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  session         WorkoutSession   @relation(fields: [sessionId], references: [id])
  exercise        ExerciseLibrary? @relation(fields: [exerciseId], references: [id])
  sets            WorkoutSet[]
  creatorEmployee Employee?        @relation("WorkoutExerciseCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?        @relation("WorkoutExerciseUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([sessionId, sortOrder])
  @@index([exerciseId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("workout_exercises")
  @@schema("public")
}

/// 训练组孙表（一个动作包含 N 组；30 行/session 是典型规模）
model WorkoutSet {
  id                String @id @default(uuid())
  workoutExerciseId String
  /// 反范式：加速跨 session 的 PR 时间线查询
  sessionId         String
  setNumber         Int

  /// 自重动作可空
  /// @precision Decimal
  weightKg Decimal? @db.Decimal(6, 2)
  reps     Int?
  /// 时间动作（plank/farmer carry）用
  timeSec  Int?
  /// 0-10
  /// @precision Decimal
  rpe      Decimal? @db.Decimal(3, 1)
  restSec  Int?

  isWarmup    Boolean @default(false)
  isCompleted Boolean @default(true)
  /// 写入时由 service 计算（Epley e1RM 破历史 max 则为 true）
  isPr        Boolean @default(false)

  notes String?

  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id])
  creatorEmployee Employee?       @relation("WorkoutSetCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?       @relation("WorkoutSetUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([workoutExerciseId, setNumber])
  @@index([sessionId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("workout_sets")
  @@schema("public")
}

// ============ 运维 / 云成本（只 ADMIN 可见） ============
// 由 cloud-cost-sync FC 每日定时拉取阿里云 BSS/CMS 数据写入；前端聚合展示。
// 仅 ADMIN 角色可见与编辑。

/// 云账单每日快照（只读，由定时同步任务写入）
model CloudBillSnapshot {
  id           String   @id @default(uuid())
  /// 快照日期（YYYY-MM-DD，按 UTC+8 计算）
  snapshotDate DateTime @db.Date
  vendor       String   @default("aliyun") @db.VarChar(20)
  /// 账期月份（YYYY-MM）
  billingCycle String   @db.VarChar(7)
  /// 云账号 UID
  accountId    String?  @db.VarChar(100)

  /// 可用余额
  /// @precision Decimal
  balanceAvailable Decimal? @db.Decimal(12, 2)
  /// 可用现金
  /// @precision Decimal
  balanceCash      Decimal? @db.Decimal(12, 2)

  /// 当月累计扣费（资源包抵扣后）
  /// @precision Decimal
  mtdAmount      Decimal? @db.Decimal(12, 2)
  /// 当月累计消耗原价
  /// @precision Decimal
  mtdGrossAmount Decimal? @db.Decimal(12, 2)

  /// 按产品的当月明细 [{productCode, productName, paidAmount, grossAmount, subscriptionType}]
  productBills     Json  @default("[]")
  /// 资源包列表 [{instanceId, productCode, packageType, region, totalAmount, remainingAmount, unit, status, effectiveTime, expiryTime, applicableProducts, remark}]
  resourcePackages Json  @default("[]")
  /// 包年包月订阅实例 [{instanceId, productCode, productName, paidAmount, billingType, expireTime}]
  subscriptions    Json  @default("[]")
  /// 原始数据（调试用，可空）
  rawPayload       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@unique([vendor, snapshotDate])
  @@index([snapshotDate])
  @@index([billingCycle])
  @@index([vendor, billingCycle])
  @@map("cloud_bill_snapshots")
  @@schema("public")
}

/// 云资源用量指标（只读，按日聚合写入）
model CloudUsageMetric {
  id          String   @id @default(uuid())
  /// 度量日期（YYYY-MM-DD）
  metricDate  DateTime @db.Date
  vendor      String   @default("aliyun") @db.VarChar(20)
  productCode String   @db.VarChar(20)
  metricName  String   @db.VarChar(80)
  /// 实例 ID（聚合数据时为 null）
  instanceId  String?  @db.VarChar(300)
  /// @precision Decimal
  value       Decimal  @db.Decimal(20, 6)
  unit        String?  @db.VarChar(20)
  /// 额外维度（如 lineType / bucket / functionName）
  meta        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  @@unique([vendor, productCode, metricName, instanceId, metricDate], name: "uniq_usage_metric")
  @@index([metricDate])
  @@index([productCode, metricDate])
  @@index([productCode, metricName, metricDate])
  @@index([instanceId, metricDate])
  @@map("cloud_usage_metrics")
  @@schema("public")
}

/// 云实例元数据（人类维护：别名 / 用途 / 业务归属 / 续费意愿）
model CloudInstanceMeta {
  id            String  @id @default(uuid())
  vendor        String  @default("aliyun") @db.VarChar(20)
  productCode   String  @db.VarChar(20)
  /// 阿里云实例 ID（i-xxx / fc_cu_dp_cn-xxx / eip-xxx 等）
  instanceId    String  @db.VarChar(300)
  /// 短别名（用于表格展示）
  alias         String? @db.VarChar(100)
  /// 详细用途说明
  purpose       String?
