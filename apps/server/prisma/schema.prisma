// ============ 钉钉同步模型 ============
// 注：DingtalkLog 已扩展为「同步 + 本地编辑」混合模型——
// source='dingtalk' 的记录由 dingtalk-sync 自动写入；source='local' 的为用户本地新增。
// 同步逻辑（apps/server/src/modules/dingtalk-sync/helpers/log-sync.helper.ts）upsert 时
// 会跳过 source='local' 与 isLocallyEdited=true 的记录，避免覆盖用户编辑。

/// 钉钉工作日志（同步自钉钉 + 本地新增/编辑）
model DingtalkLog {
  reportId        String    @id @db.VarChar(50)
  templateName    String?   @db.VarChar(50)
  creatorId       String?   @db.VarChar(50)
  creatorName     String?   @db.VarChar(100)
  deptName        String?   @db.VarChar(100)
  /// 钉钉同步过来的纯文本正文（含 \r\n 换行），与 contentsJson 二选一显示
  contents        String?
  /// 结构化正文 [{key, value}]，本地新增/编辑时主要使用；展示时若存在则按段渲染
  contentsJson    Json?
  createTime      DateTime?
  syncedAt        DateTime  @default(now())
  /// 来源：dingtalk=同步自钉钉；local=本地新增
  source          String    @default("dingtalk") @db.VarChar(20)
  /// 是否已被本地编辑过（同步时不再覆盖）
  isLocallyEdited Boolean   @default(false)
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([creatorId])
  @@index([createTime])
  @@index([syncedAt])
  @@index([source])
  @@map("dingtalk_logs")
  @@schema("public")
}

/// 钉钉日程事件（同步自钉钉，只读）
model DingtalkCalendarEvent {
  eventId     String    @id @db.VarChar(100)
  title       String?   @db.VarChar(500)
  description String?
  startTime   DateTime?
  endTime     DateTime?
  location    String?   @db.VarChar(200)
  creator     String?   @db.VarChar(100)
  attendees   Json?
  syncedAt    DateTime  @default(now())

  @@map("dingtalk_calendar_events")
  @@schema("public")
}

/// 离职人员（同步自钉钉，只读）
model EmployeeLeave {
  id             String    @id @default(uuid())
  dingtalkUserId String    @db.VarChar(50)
  name           String    @db.VarChar(100)
  mobile         String?   @db.VarChar(20)
  leaveTime      DateTime?
  leaveReason    String?   @db.VarChar(500)
  syncedAt       DateTime  @default(now())

  @@unique([dingtalkUserId, leaveTime])
  @@index([leaveTime])
  @@index([syncedAt])
  @@map("employee_leaves")
  @@schema("public")
}

// ============ 审批流程模块 ============

