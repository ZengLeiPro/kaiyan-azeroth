/// 订单产品明细（快照模式，不建立 CrmProduct 外键）
model OrderProduct {
  id                  String          @id @default(uuid())
  yccrmId             String?         @unique @db.VarChar(100)
  saleOrderId         String
  productName         String          @db.VarChar(200)
  productNumber       String?         @db.VarChar(50)
  /// @precision Decimal
  productPrice        Decimal?        @db.Decimal(12, 2)
  /// @precision Decimal
  quantity            Decimal?        @db.Decimal(12, 2)
  /// @precision Decimal
  unitPrice           Decimal?        @db.Decimal(12, 2)
  /// @precision Decimal
  contractUnitPrice   Decimal?        @db.Decimal(12, 2)
  /// @precision Decimal
  discount            Decimal?        @db.Decimal(5, 2)
  /// @precision Decimal
  subtotalAmount      Decimal?        @db.Decimal(12, 2)
  remark              String?
  flowStatus          String?         @db.VarChar(50)
  /// 产品行级财务科目（绑定方案 v2.2）：由 CrmProduct.defaultFinanceSubjectId 继承，可手工调整
  financeSubjectId    String?
  financeSubject      FinanceSubject? @relation("OrderProductFinanceSubject", fields: [financeSubjectId], references: [id], onDelete: SetNull)
  /// 产品行级收款模式（绑定方案 v2.2）：direct / dingtalk_collect / pass_through / pass_through_cost
  /// 由 CrmProduct.defaultPaymentMode 继承；同步钩子据此决定派生 ledger 与否
  paymentMode         String          @default("direct") @db.VarChar(20)
  /// 反向缓存（绑定方案 v2.2）：产品行级已回款金额
  /// = Σ PaymentItem.amount where saleOrderProductId=this.id AND deletedAt IS NULL
  ///   AND payment.flowStatus='approved' AND payment.legacyAdjustment=false
  ///   AND payment.deletedAt IS NULL
  /// 由 PaymentItem 增删改 + payment 撤回/软删 同事务刷新；watchdog cron 每天 03:00 对账
  /// @precision Decimal
  totalReceivedAmount Decimal         @default(0) @db.Decimal(12, 2)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  version             Int             @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId   String?
  updaterEmployeeId   String?
  creator             Employee?       @relation("OrderProductCreator", fields: [creatorEmployeeId], references: [id])
  updater             Employee?       @relation("OrderProductUpdater", fields: [updaterEmployeeId], references: [id])
  // 关联
  saleOrder           SaleOrder       @relation(fields: [saleOrderId], references: [id])
  /// 反向 1:N：所有指向本 OrderProduct 的 PaymentItem
  paymentItems        PaymentItem[]

  @@index([saleOrderId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@index([financeSubjectId])
  @@index([paymentMode])
  @@map("order_products")
  @@schema("public")
}

