/// 销售数据待办/作战项：夜间缺口侦探 + 晨间简报共用（销售数据闭环系统）
/// 写入一律进此表人工采纳，绝不直接写 CRM（D1）。
/// 进攻类(FOLLOW_UP_DUE/DEAL_COOLING/PAYMENT_SILENT/CUSTOMER_STALE)在工作台「今日作战」卡呈现；
/// 防御类(GAP_HARD/GAP_SOFT/CONFLICT/FILL_CONFIRM)在「数据待办」卡呈现。
model SalesActionItem {
  id                 String       @id @default(uuid())
  // 收件销售（强制 = 当前登录人，前端不可传；夜间 cron 以各销售 employeeId 写入）
  employeeId         String
  employee           Employee     @relation("SalesActionOwner", fields: [employeeId], references: [id], onDelete: Restrict)
  // 进攻: FOLLOW_UP_DUE / DEAL_COOLING / PAYMENT_SILENT / CUSTOMER_STALE
  // 防御: GAP_HARD / GAP_SOFT / CONFLICT / FILL_CONFIRM
  category           String       @db.VarChar(24)
  // 0-100，ORDER BY DESC（高=优先）；不截断数量（砍了条数上限）
  priority           Int
  // Opportunity / Customer / KeepRecord 等
  refType            String?      @db.VarChar(30)
  refId              String?
  title              String       @db.VarChar(200)
  // 「为什么提醒你」一句话，必须含具体数字
  reason             String
  suggestedAction    String?
  // 采纳草稿：FILL_CONFIRM 须含 kind='keep_record' + matchMode='FULL_NAME_EXPLICIT'
  // + matchedCustomerId + matchedFullName + evidenceMessageId + payload（见 shared types）
  aiDraft            Json?        @db.JsonB
  // 证据数组：dingtalk_msg(含 msgId) / doc / calendar 三来源（见 shared types）
  evidence           Json?        @db.JsonB
  // HIGH(硬缺口/高置信) / MEDIUM(软缺口)
  confidence         String       @db.VarChar(10)
  // category + refId 指纹；活跃唯一约束靠 raw migration 的 partial unique index（schema 不写 @@unique）
  dedupKey           String       @db.VarChar(120)
  // pending / adopted / done / ignored / snoozed / auto_expired
  status             String       @default("pending") @db.VarChar(16)
  // ignore 时必填(D7)；done 时记录实际处置结果
  resolveNote        String?
  // done 时必填：progressed / shelved / false_alarm / other
  doneType           String?      @db.VarChar(16)
  snoozeUntil        DateTime?
  remindCount        Int          @default(0)
  // 采纳后写入的 CRM 记录类型（撤销用），如 'keep_record'
  resultType         String?      @db.VarChar(30)
  resultId           String?
  // 哪批夜间 run，回滚/排查用
  sourceRunId        String?      @db.VarChar(64)
  createdVia         String       @default("agent") @db.VarChar(40)
  // 审计六件套（新约定，带 FK；参照 Notification）
  createdAt          DateTime     @default(now())
  creatorEmployeeId  String?
  updatedAt          DateTime     @default(now()) @updatedAt
  updaterEmployeeId  String?
  resolvedAt         DateTime?
  resolvedById       String?
  deletedAt          DateTime?
  version            Int          @default(1)
  creatorEmployee    Employee?    @relation("SalesActionItemCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee    Employee?    @relation("SalesActionItemUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)
  resolvedBy         Employee?    @relation("SalesActionItemResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // 反向：采纳本待办生成的跟进记录
  adoptedKeepRecords KeepRecord[] @relation("KeepRecordFromActionItem")

  @@index([employeeId, status, priority])
  @@index([sourceRunId])
  @@index([dedupKey])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@index([resolvedById])
  @@map("sales_action_items")
  @@schema("public")
}

/// 官网留资导入幂等台账（纯机器台账，非业务操作界面）。
/// 业务实体仍落 Customer / Contact / SalesActionItem；本表只防 collector 重试或并发重复建客户。
model WebsiteLeadImport {
  id           String    @id @default(uuid())
  sourceId     String    @unique @db.VarChar(96)
  phone        String    @db.VarChar(32)
  status       String    @default("processing") @db.VarChar(16)
  customerId   String?
  actionItemId String?
  sourceSite   String?   @db.VarChar(255)
  sourcePath   String?   @db.VarChar(512)
  placement    String?   @db.VarChar(120)
  channel      String?   @db.VarChar(120)
  payload      Json?     @db.JsonB
  importedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([phone])
  @@index([customerId])
  @@index([actionItemId])
  @@index([status, createdAt])
  @@map("website_lead_imports")
  @@schema("public")
}

/// 夜间同步幂等台账（纯机器台账，非人工业务实体）：防夜间 cron 重试重复写。
/// 参照 SEO 机器同步表风格：无人工创建/修改者，审计字段豁免创建人/更新人。
model SyncDedupLedger {
  id               String    @id @default(uuid())
  // 哪批夜间 run
  runId            String    @db.VarChar(64)
  // 事实归属销售（客户负责人 employeeId）
  sourceEmployeeId String
  // 来源类型：dingtalk_msg / doc / calendar 等
  sourceType       String    @db.VarChar(30)
  // 来源消息/文档/日程 id（可空，部分来源无单条 id）
  sourceMessageId  String?   @db.VarChar(128)
  // sha1(customerId|chargerEmployeeId|factDate|normalize(factCoreText))
  dedupKey         String    @unique @db.VarChar(120)
  // seen / written / skipped
  status           String    @default("seen") @db.VarChar(16)
  // 该 dedupKey 首次/最近被看到的时刻（业务语义时间，事实去重用）
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now()) @updatedAt
  // 审计（机器表：参照 SEO 同步表，仅时间/软删/版本，豁免创建人/更新人，见 check-audit-fields ALLOWLIST）
  createdAt        DateTime  @default(now())
  createdBy        String?
  updatedAt        DateTime  @default(now()) @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  version          Int       @default(1)

  @@index([runId])
  @@index([sourceEmployeeId])
  @@map("sync_dedup_ledger")
  @@schema("public")
}

/// CRM 产品
model CrmProduct {
  id                      String          @id @default(uuid())
  yccrmId                 String?         @unique @db.VarChar(100)
  productName             String          @db.VarChar(200)
  productNumber           String?         @db.VarChar(50)
  productTypes            String?         @db.VarChar(100)
  productUnit             String?         @db.VarChar(50)
  /// @precision Decimal
  standardPrice           Decimal?        @db.Decimal(12, 2)
  productStatus           String?         @db.VarChar(50)
  remark                  String?
  flowStatus              String?         @db.VarChar(50)
  status                  String          @default("active") @db.VarChar(20)
  /// 默认财务科目（绑定方案 v2.2）：新建 OrderProduct 时继承到 OrderProduct.financeSubjectId
  defaultFinanceSubjectId String?
  defaultFinanceSubject   FinanceSubject? @relation("CrmProductDefaultSubject", fields: [defaultFinanceSubjectId], references: [id], onDelete: SetNull)
  /// 默认收款模式（绑定方案 v2.2）：direct / dingtalk_collect / pass_through
  /// 例：钉钉一方品 defaultPaymentMode='dingtalk_collect'；定制/三方品='direct'
  defaultPaymentMode      String          @default("direct") @db.VarChar(20)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime?
  version                 Int             @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId       String?
  updaterEmployeeId       String?
  creator                 Employee?       @relation("CrmProductCreator", fields: [creatorEmployeeId], references: [id])
  updater                 Employee?       @relation("CrmProductUpdater", fields: [updaterEmployeeId], references: [id])

  @@index([status])
  @@index([productStatus])
  @@index([productTypes])
  @@index([productUnit])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([standardPrice])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@index([defaultFinanceSubjectId])
  @@map("crm_products")
  @@schema("public")
}

