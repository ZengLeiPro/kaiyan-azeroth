generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "web_analytics"]
}

// ============ 系统核心模型 ============

/// 用户会话（push 6 起：以 employee.id 为身份主键，不再有 userId）
model Session {
  id             String   @id @default(uuid())
  employeeId     String
  deviceType     String   @db.VarChar(20)
  deviceName     String   @db.VarChar(100)
  browser        String   @db.VarChar(50)
  os             String   @db.VarChar(50)
  ipAddress      String   @db.VarChar(50)
  location       String?  @db.VarChar(100)
  refreshToken   String   @unique @db.VarChar(500)
  loginTime      DateTime @default(now())
  lastActiveTime DateTime @default(now())
  expiresAt      DateTime
  employee       Employee @relation("EmployeeSessions", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([refreshToken])
  @@map("sessions")
  @@schema("public")
}

/// 长期访问令牌（Personal Access Token）
/// 用于第三方系统（如 agent 平台）以特定 employee 身份调用 API。
/// 走完整 RBAC 链路：tokenHash 命中后注入对应 employee 身份。
/// 与 Session/refreshToken 解耦，不参与短期 access token 的轮换。
model PersonalAccessToken {
  id                String    @id @default(uuid())
  employeeId        String
  name              String    @db.VarChar(100) // 用途描述，如 "agent-ops-bot"
  tokenHash         String    @unique @db.VarChar(128) // SHA-256(token) 的 hex
  prefix            String    @db.VarChar(50) // token 前缀（pat_<username>_前 8 位 hex），仅供管理界面识别，不参与鉴权
  lastUsedAt        DateTime?
  lastUsedIp        String?   @db.VarChar(50)
  expiresAt         DateTime? // null = 不过期
  revokedAt         DateTime? // null = 有效
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  employee          Employee  @relation("EmployeePats", fields: [employeeId], references: [id], onDelete: Cascade)
  creatorEmployee   Employee? @relation("PatCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([revokedAt])
  @@index([creatorEmployeeId])
  @@map("personal_access_tokens")
  @@schema("public")
}

/// 角色
model Role {
  id                String           @id @default(uuid())
  code              String           @unique @db.VarChar(50)
  name              String           @db.VarChar(50)
  description       String?
  status            String           @default("active") @db.VarChar(20)
  createdAt         DateTime         @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime         @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int              @default(1)
  permissions       RolePermission[]
  users             UserRole[]
  creatorEmployee   Employee?        @relation("RoleCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee   Employee?        @relation("RoleUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("roles")
  @@schema("public")
}

/// 员工角色关联（push 6 起：主键 (employeeId, roleId)，无 userId 列）
model UserRole {
  employeeId String
  roleId     String
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  employee   Employee @relation("EmployeeRoles", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("public")
}

/// 角色权限
model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  module    String   @db.VarChar(50)
  menu      String   @db.VarChar(50)
  view      Boolean  @default(false)
  create    Boolean  @default(false)
  edit      Boolean  @default(false)
  delete    Boolean  @default(false)
  export    Boolean  @default(false)
  approve   Boolean  @default(false)
  /// 数据范围：SELF=仅本人，ALL=全部。多角色取最大范围（OR）
  viewScope String   @default("SELF") @db.VarChar(20)
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, menu])
  @@index([module, menu])
  @@map("role_permissions")
  @@schema("public")
}

/// 系统参数配置
model SystemConfig {
  id                String    @id @default(uuid())
  code              String    @unique @db.VarChar(100)
  name              String    @db.VarChar(100)
  value             String
  type              String    @db.VarChar(20)
  group             String    @db.VarChar(50)
  description       String?
  // 审计
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)
  creatorEmployee   Employee? @relation("SystemConfigCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee   Employee? @relation("SystemConfigUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("system_configs")
  @@schema("public")
}

/// 节假日设置
/// 仅存「打破默认规则的日期」：HOLIDAY=法定节假日（默认工作日 → 改休），
/// WORKDAY=调休补班（默认周末 → 改上班）。周末按 dayOfWeek 实时计算，不入库。
model Holiday {
  id                String    @id @default(uuid())
  date              DateTime  @unique @db.Date // 节假日的日期（无时分秒）
  year              Int // 冗余，便于按年索引/查询
  type              String    @db.VarChar(20) // 'HOLIDAY' | 'WORKDAY'
  note              String?   @db.VarChar(100) // 如 '元旦' / '春节调休'
  // 审计
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  version           Int       @default(1)
  creatorEmployee   Employee? @relation("HolidayCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee   Employee? @relation("HolidayUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([year])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("holidays")
  @@schema("public")
}

/// 列表页筛选方案配置
model FilterScheme {
  id                String    @id @default(uuid())
  pageKey           String    @unique @db.VarChar(80)
  configJson        Json
  version           Int       @default(1)
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  updaterEmployee   Employee? @relation("FilterSchemeUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([updaterEmployeeId])
  @@map("filter_schemes")
  @@schema("public")
}

/// 用户按页面保存的筛选栏展示配置
model PersonalFilterPreference {
  id         String   @id @default(uuid())
  employeeId String
  pageKey    String   @db.VarChar(80)
  configJson Json
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation("PersonalFilterPreferenceOwner", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employeeId, pageKey])
  @@index([pageKey])
  @@map("personal_filter_preferences")
  @@schema("public")
}

/// 用户保存的命名筛选条件方案
model PersonalFilterPreset {
  id          String   @id @default(uuid())
  employeeId  String
  pageKey     String   @db.VarChar(80)
  name        String   @db.VarChar(80)
  filtersJson Json
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation("PersonalFilterPresetOwner", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employeeId, pageKey, name])
  @@index([employeeId, pageKey, updatedAt])
  @@map("personal_filter_presets")
  @@schema("public")
}

/// 列表表格的全员默认配置（管理员推送的列宽 / 列显隐）
/// pageKey 形如 "/crm/customers" 或 "/approvals:pending"（path + 可选 storageId）
/// configJson: { visibility?: Record<string,boolean>, widths?: Record<string,number> }
/// version: 每次 admin 保存自增，客户端依据它判断"是否需要强制覆盖本地"
model TablePreference {
  id                String    @id @default(uuid())
  pageKey           String    @unique @db.VarChar(200)
  configJson        Json
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  creatorEmployeeId String?
  updaterEmployeeId String?
  creatorEmployee   Employee? @relation("TablePreferenceCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee   Employee? @relation("TablePreferenceUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("table_preferences")
  @@schema("public")
}

/// 操作日志
/// targetCustomerId：客户级活动时间线投影专用字段（2026-06-16 引入）
///   - module='customers' → 取 target（customer.id 本身）
///   - 其他 CRM module → 由 CrmChangeLogService 从 before/after.customerId 自动推导
///   - 非 CRM module（crm-products 等无客户归属）→ null
/// 不参与业务约束，仅为 GET /customers/:id/activities 提供索引化过滤通道。
model OperationLog {
  id               String    @id @default(uuid())
  employeeId       String?
  ipAddress        String?   @db.VarChar(50)
  module           String    @db.VarChar(50)
  action           String    @db.VarChar(20)
  target           String?   @db.VarChar(100)
  targetCustomerId String?   @db.VarChar(50)
  details          Json?
  createdAt        DateTime  @default(now())
  employee         Employee? @relation("EmployeeOperationLogs", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([module])
  @@index([module, target, createdAt])
  @@index([createdAt])
  @@index([targetCustomerId, createdAt(sort: Desc)])
  @@map("operation_logs")
  @@schema("public")
}

/// 登录日志（不可变审计日志，不存在更新/软删除/并发编辑场景）
model LoginLog {
  id         String    @id @default(uuid())
  employeeId String?
  username   String    @db.VarChar(100)
  actionType String    @db.VarChar(10)
  ip         String    @db.VarChar(50)
  userAgent  String?   @db.VarChar(500)
  location   String?   @db.VarChar(200)
  status     String    @db.VarChar(10)
  failReason String?
  createdAt  DateTime  @default(now())
  employee   Employee? @relation("EmployeeLoginLogs", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([createdAt])
  @@map("login_logs")
  @@schema("public")
}

/// 通知消息（push 6 起：以 employee 为收件主体，不再有 userId）
model Notification {
  id                String    @id @default(uuid())
  employeeId        String
  recipientEmployee Employee  @relation("EmployeeNotifications", fields: [employeeId], references: [id], onDelete: Restrict)
  type              String    @db.VarChar(50)
  title             String    @db.VarChar(200)
  content           String
  link              String?   @db.VarChar(500)
  isRead            Boolean   @default(false)
  readAt            DateTime?
  // 审计
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @default(now()) @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)
  creatorEmployee   Employee? @relation("NotificationCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee   Employee? @relation("NotificationUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([isRead])
  @@index([createdAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("notifications")
  @@schema("public")
}

/// 业务编号计数器表
model SerialNumberCounter {
  id        String   @id @default(cuid())
  /// 编号类型，如 CUSTOMER, SALE_ORDER
  type      String   @db.VarChar(50)
  /// 日期键，格式 YYMMDD，档案类为空字符串
  dateKey   String?  @db.VarChar(10)
  /// 当前计数值
  counter   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, dateKey])
  @@map("serial_number_counters")
  @@schema("public")
}

// ============ 组织架构模型 ============

/// 员工档案
model Employee {
  id                                String                     @id @default(uuid())
  serialNumber                      String                     @unique @db.VarChar(32)
  name                              String                     @db.VarChar(50)
  phone                             String?                    @db.VarChar(20)
  email                             String?                    @db.VarChar(100)
  gender                            String?                    @db.VarChar(10)
  position                          String?                    @db.VarChar(50)
  /// 工时单价（元/小时），按岗位/角色设定
  /// @precision Decimal
  hourlyRate                        Decimal?                   @db.Decimal(10, 2)
  status                            String                     @default("active") @db.VarChar(20)
  entryDate                         DateTime?
  avatar                            String?                    @db.VarChar(500)
  // 钉钉同步字段
  dingtalkUserId                    String?                    @unique @db.VarChar(50)
  /// 全局 nullable UNIQUE 由 contract-migrations/20260824230000_employee_dingtalk_union_unique 人工收口；
  /// 收口前应用层仍须 fail-closed 检测重复，不得假设生产数据唯一。
  dingtalkUnionId                   String?                    @db.VarChar(50)
  jobNumber                         String?                    @db.VarChar(50)
  workPlace                         String?                    @db.VarChar(200)
  isAdmin                           Boolean                    @default(false)
  isBoss                            Boolean                    @default(false)
  isLeader                          Boolean                    @default(false)
  dingtalkActive                    Boolean                    @default(true)
  dingtalkExtension                 Json?
  lastSyncAt                        DateTime?
  // 登录字段（push 1 加，从 users 表迁移；push 2 数据回填，push 6 删 users 表完成合并）
  username                          String?                    @unique @db.VarChar(50)
  password                          String?                    @db.VarChar(255)
  // 2026-05-23：默认值从 "active" 改为 "disabled"，与 canLogin 默认 false 对齐。
  // 鉴权门是 `loginStatus !== 'active' || !canLogin`，新建员工默认应当不能登录，
  // 由管理员显式经 users.updateStatus() 同步开通 loginStatus + canLogin。
  loginStatus                       String                     @default("disabled") @db.VarChar(20)
  canLogin                          Boolean                    @default(false)
  lastLoginAt                       DateTime?
  lastLoginIp                       String?                    @db.VarChar(50)
  loginFailCount                    Int                        @default(0)
  lockUntil                         DateTime?
  /// push 4 新增：JWT iat < tokenInvalidAfter 视为失效；用于强制重登（NOW() 即可全员失效）
  tokenInvalidAfter                 DateTime?
  // 审计字段
  createdAt                         DateTime                   @default(now())
  creatorEmployeeId                 String?
  updatedAt                         DateTime                   @updatedAt
  updaterEmployeeId                 String?
  deletedAt                         DateTime?
  version                           Int                        @default(1)
  // 关联
  creatorEmployee                   Employee?                  @relation("EmployeeCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee                   Employee?                  @relation("EmployeeUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)
  createdEmployees                  Employee[]                 @relation("EmployeeCreator")
  updatedEmployees                  Employee[]                 @relation("EmployeeUpdater")
  departments                       EmployeeDepartment[]       @relation("EmployeeDepartmentMember")
  managedDepartments                Department[]               @relation("DepartmentManager")
  // 反向关联：Employee ID 归一化
  chargedCustomers                  Customer[]                 @relation("CustomerCharger")
  chargedOpportunities              Opportunity[]              @relation("OpportunityCharger")
  chargedSaleOrders                 SaleOrder[]                @relation("SaleOrderCharger")
  chargedPayments                   Payment[]                  @relation("PaymentCharger")
  chargedInvoices                   Invoice[]                  @relation("InvoiceCharger")
  payrollRecords                    PayrollRecord[]            @relation("PayrollRecordEmployee")
  chargedKeepRecords                KeepRecord[]               @relation("KeepRecordCharger")
  chargedVisitRecords               VisitRecord[]              @relation("VisitRecordCharger")
  sentWorkDailies                   CrmWorkDaily[]             @relation("WorkDailySender")
  ownedProjects                     Project[]                  @relation("ProjectOwner")
  ownedEffortRecords                EffortRecord[]             @relation("EffortOwner")
  projectMemberships                ProjectMember[]            @relation("MemberEmployee")
  dispatchedTickets                 ProjectTicket[]            @relation("TicketDispatcher")
  assignedTickets                   ProjectTicket[]            @relation("TicketAssignee")
  // 反向关联：yccrm 历史数据创建人/修改人（04-28 新增）
  createdCustomers                  Customer[]                 @relation("CustomerCreator")
  updatedCustomers                  Customer[]                 @relation("CustomerUpdater")
  leadStageUpdatedCustomers         Customer[]                 @relation("CustomerLeadStageUpdater")
  leadStageQualifiedCustomers       Customer[]                 @relation("CustomerLeadStageQualifier")
  leadProgressUpdatedCustomers      Customer[]                 @relation("CustomerLeadProgressUpdater")
  createdContacts                   Contact[]                  @relation("ContactCreator")
  updatedContacts                   Contact[]                  @relation("ContactUpdater")
  createdOpportunities              Opportunity[]              @relation("OpportunityCreator")
  updatedOpportunities              Opportunity[]              @relation("OpportunityUpdater")
  createdSaleOrders                 SaleOrder[]                @relation("SaleOrderCreator")
  updatedSaleOrders                 SaleOrder[]                @relation("SaleOrderUpdater")
  createdPayments                   Payment[]                  @relation("PaymentCreator")
  updatedPayments                   Payment[]                  @relation("PaymentUpdater")
  createdPaymentItems               PaymentItem[]              @relation("PaymentItemCreator")
  updatedPaymentItems               PaymentItem[]              @relation("PaymentItemUpdater")
  createdInvoices                   Invoice[]                  @relation("InvoiceCreator")
  updatedInvoices                   Invoice[]                  @relation("InvoiceUpdater")
  createdKeepRecords                KeepRecord[]               @relation("KeepRecordCreator")
  updatedKeepRecords                KeepRecord[]               @relation("KeepRecordUpdater")
  createdVisitRecords               VisitRecord[]              @relation("VisitRecordCreator")
  updatedVisitRecords               VisitRecord[]              @relation("VisitRecordUpdater")
  createdCrmProducts                CrmProduct[]               @relation("CrmProductCreator")
  updatedCrmProducts                CrmProduct[]               @relation("CrmProductUpdater")
  createdOpportunityProducts        OpportunityProduct[]       @relation("OpportunityProductCreator")
  updatedOpportunityProducts        OpportunityProduct[]       @relation("OpportunityProductUpdater")
  createdOrderProducts              OrderProduct[]             @relation("OrderProductCreator")
  updatedOrderProducts              OrderProduct[]             @relation("OrderProductUpdater")
  createdCrmWorkDailies             CrmWorkDaily[]             @relation("CrmWorkDailyCreator")
  updatedCrmWorkDailies             CrmWorkDaily[]             @relation("CrmWorkDailyUpdater")
  // 反向关联：push 4 新增的 6 张鉴权 FK 表 employeeId
  sessions                          Session[]                  @relation("EmployeeSessions")
  personalAccessTokens              PersonalAccessToken[]      @relation("EmployeePats")
  userRoles                         UserRole[]                 @relation("EmployeeRoles")
  operationLogs                     OperationLog[]             @relation("EmployeeOperationLogs")
  loginLogs                         LoginLog[]                 @relation("EmployeeLoginLogs")
  notifications                     Notification[]             @relation("EmployeeNotifications")
  // 反向关联：push 1 新增的 31 张表 creator/updater（push 6 起 User 表已删除）
  createdPats                       PersonalAccessToken[]      @relation("PatCreator")
  createdRoles                      Role[]                     @relation("RoleCreator")
  updatedRoles                      Role[]                     @relation("RoleUpdater")
  createdSystemConfigs              SystemConfig[]             @relation("SystemConfigCreator")
  updatedSystemConfigs              SystemConfig[]             @relation("SystemConfigUpdater")
  createdHolidays                   Holiday[]                  @relation("HolidayCreator")
  updatedHolidays                   Holiday[]                  @relation("HolidayUpdater")
  updatedFilterSchemes              FilterScheme[]             @relation("FilterSchemeUpdater")
  personalFilterPreferences         PersonalFilterPreference[] @relation("PersonalFilterPreferenceOwner")
  personalFilterPresets             PersonalFilterPreset[]     @relation("PersonalFilterPresetOwner")
  createdTablePreferences           TablePreference[]          @relation("TablePreferenceCreator")
  updatedTablePreferences           TablePreference[]          @relation("TablePreferenceUpdater")
  createdNotifications              Notification[]             @relation("NotificationCreator")
  updatedNotifications              Notification[]             @relation("NotificationUpdater")
  // 销售数据闭环：待办收件人 + 审计/处置人
  salesActionItems                  SalesActionItem[]          @relation("SalesActionOwner")
  createdSalesActionItems           SalesActionItem[]          @relation("SalesActionItemCreator")
  updatedSalesActionItems           SalesActionItem[]          @relation("SalesActionItemUpdater")
  resolvedSalesActionItems          SalesActionItem[]          @relation("SalesActionItemResolver")
  createdDepartments                Department[]               @relation("DepartmentCreator")
  updatedDepartments                Department[]               @relation("DepartmentUpdater")
  createdEmployeeDepartments        EmployeeDepartment[]       @relation("EmployeeDepartmentCreator")
  createdPayrollImportBatches       PayrollImportBatch[]       @relation("PayrollImportBatchCreator")
  updatedPayrollImportBatches       PayrollImportBatch[]       @relation("PayrollImportBatchUpdater")
  createdPayrollPeriods             PayrollPeriod[]            @relation("PayrollPeriodCreator")
  updatedPayrollPeriods             PayrollPeriod[]            @relation("PayrollPeriodUpdater")
  createdPayrollRecords             PayrollRecord[]            @relation("PayrollRecordCreator")
  updatedPayrollRecords             PayrollRecord[]            @relation("PayrollRecordUpdater")
  createdProjects                   Project[]                  @relation("ProjectCreator")
  updatedProjects                   Project[]                  @relation("ProjectUpdater")
  createdProjectSaleOrders          ProjectSaleOrder[]         @relation("ProjectSaleOrderCreator")
  createdProjectMembers             ProjectMember[]            @relation("ProjectMemberCreator")
  updatedProjectMembers             ProjectMember[]            @relation("ProjectMemberUpdater")
  createdEffortRecords              EffortRecord[]             @relation("EffortRecordCreator")
  updatedEffortRecords              EffortRecord[]             @relation("EffortRecordUpdater")
  createdProjectTickets             ProjectTicket[]            @relation("ProjectTicketCreator")
  updatedProjectTickets             ProjectTicket[]            @relation("ProjectTicketUpdater")
  createdApprovalFlows              ApprovalFlow[]             @relation("ApprovalFlowCreator")
  updatedApprovalFlows              ApprovalFlow[]             @relation("ApprovalFlowUpdater")
  createdApprovalFlowNodes          ApprovalFlowNode[]         @relation("ApprovalFlowNodeCreator")
  updatedApprovalFlowNodes          ApprovalFlowNode[]         @relation("ApprovalFlowNodeUpdater")
  createdApprovalInstances          ApprovalInstance[]         @relation("ApprovalInstanceCreator")
  updatedApprovalInstances          ApprovalInstance[]         @relation("ApprovalInstanceUpdater")
  createdApprovalTasks              ApprovalTask[]             @relation("ApprovalTaskCreator")
  updatedApprovalTasks              ApprovalTask[]             @relation("ApprovalTaskUpdater")
  createdApprovalChangeRequests     ApprovalChangeRequest[]    @relation("ApprovalChangeRequestCreator")
  updatedApprovalChangeRequests     ApprovalChangeRequest[]    @relation("ApprovalChangeRequestUpdater")
  createdDietFoods                  DietFood[]                 @relation("DietFoodCreator")
  updatedDietFoods                  DietFood[]                 @relation("DietFoodUpdater")
  createdDietSupplements            DietSupplement[]           @relation("DietSupplementCreator")
  updatedDietSupplements            DietSupplement[]           @relation("DietSupplementUpdater")
  createdDietPlans                  DietPlan[]                 @relation("DietPlanCreator")
  updatedDietPlans                  DietPlan[]                 @relation("DietPlanUpdater")
  createdDietMealSlots              DietMealSlot[]             @relation("DietMealSlotCreator")
  updatedDietMealSlots              DietMealSlot[]             @relation("DietMealSlotUpdater")
  createdDietPlanSupplements        DietPlanSupplement[]       @relation("DietPlanSupplementCreator")
  updatedDietPlanSupplements        DietPlanSupplement[]       @relation("DietPlanSupplementUpdater")
  createdDietDailyLogs              DietDailyLog[]             @relation("DietDailyLogCreator")
  updatedDietDailyLogs              DietDailyLog[]             @relation("DietDailyLogUpdater")
  createdDietDailyMealEntries       DietDailyMealEntry[]       @relation("DietDailyMealEntryCreator")
  updatedDietDailyMealEntries       DietDailyMealEntry[]       @relation("DietDailyMealEntryUpdater")
  createdDietDailySupplementEntries DietDailySupplementEntry[] @relation("DietDailySupplementEntryCreator")
  updatedDietDailySupplementEntries DietDailySupplementEntry[] @relation("DietDailySupplementEntryUpdater")
  createdDietWaterLogs              DietWaterLog[]             @relation("DietWaterLogCreator")
  updatedDietWaterLogs              DietWaterLog[]             @relation("DietWaterLogUpdater")
  createdDietSubjectiveLogs         DietSubjectiveLog[]        @relation("DietSubjectiveLogCreator")
  updatedDietSubjectiveLogs         DietSubjectiveLog[]        @relation("DietSubjectiveLogUpdater")
  createdBodyMetrics                BodyMetric[]               @relation("BodyMetricCreator")
  updatedBodyMetrics                BodyMetric[]               @relation("BodyMetricUpdater")
  createdDietPurchaseItems          DietPurchaseItem[]         @relation("DietPurchaseItemCreator")
  updatedDietPurchaseItems          DietPurchaseItem[]         @relation("DietPurchaseItemUpdater")
  // 已下线健康中心遗留表（expand-only，待 contract DROP）
  createdExerciseLibraries          ExerciseLibrary[]          @relation("ExerciseLibraryCreator")
  updatedExerciseLibraries          ExerciseLibrary[]          @relation("ExerciseLibraryUpdater")
  createdWorkoutSessions            WorkoutSession[]           @relation("WorkoutSessionCreator")
  updatedWorkoutSessions            WorkoutSession[]           @relation("WorkoutSessionUpdater")
  createdWorkoutExercises           WorkoutExercise[]          @relation("WorkoutExerciseCreator")
  updatedWorkoutExercises           WorkoutExercise[]          @relation("WorkoutExerciseUpdater")
  createdWorkoutSets                WorkoutSet[]               @relation("WorkoutSetCreator")
  updatedWorkoutSets                WorkoutSet[]               @relation("WorkoutSetUpdater")
  // 财务模块（仅 admin 用户可见，username='admin' 锁死）
  createdFinanceAccounts            FinanceAccount[]           @relation("FinanceAccountCreator")
  updatedFinanceAccounts            FinanceAccount[]           @relation("FinanceAccountUpdater")
  createdFinanceSubjects            FinanceSubject[]           @relation("FinanceSubjectCreator")
  updatedFinanceSubjects            FinanceSubject[]           @relation("FinanceSubjectUpdater")
  createdFinanceLedgers             FinanceLedger[]            @relation("FinanceLedgerCreator")
  updatedFinanceLedgers             FinanceLedger[]            @relation("FinanceLedgerUpdater")
  createdFinancePersonalLedgers     FinancePersonalLedger[]    @relation("FinancePersonalLedgerCreator")
  updatedFinancePersonalLedgers     FinancePersonalLedger[]    @relation("FinancePersonalLedgerUpdater")
  createdFinanceImportBatches       FinanceImportBatch[]       @relation("FinanceImportBatchCreator")
  updatedFinanceImportBatches       FinanceImportBatch[]       @relation("FinanceImportBatchUpdater")
  uploadedFileAssets                FileAsset[]                @relation("FileAssetOwner")

  @@index([status])
  @@index([gender])
  @@index([entryDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isAdmin])
  @@index([isLeader])
  @@index([dingtalkActive])
  @@index([username])
  @@index([canLogin])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("employees")
  @@schema("public")
}

/// 上传文件资产。业务对象仍在各自 attachments JSON 中维护关联与读取权限；
/// 本表只记录不可变的存储身份和上传人，下载授权由业务响应签发的短时令牌控制。
model FileAsset {
  id              String   @id @default(uuid())
  storageKey      String   @unique @db.VarChar(600)
  originalName    String   @db.VarChar(255)
  size            Int
  mimeType        String   @db.VarChar(150)
  ownerEmployeeId String
  ownerEmployee   Employee @relation("FileAssetOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([ownerEmployeeId, createdAt])
  @@map("file_assets")
  @@schema("public")
}

/// 常驻内部运维入口的幂等执行账本。
model InternalOperationExecution {
  id             String    @id @default(uuid())
  operation      String    @db.VarChar(80)
  idempotencyKey String    @db.VarChar(120)
  requestHash    String    @db.VarChar(64)
  status         String    @db.VarChar(20)
  resultJson     Json?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  @@unique([operation, idempotencyKey])
  @@index([operation, createdAt])
  @@map("internal_operation_executions")
  @@schema("public")
}

/// 部门
model Department {
  id                String               @id @default(uuid())
  name              String               @db.VarChar(100)
  parentId          String?
  sortOrder         Int                  @default(0)
  status            String               @default("active") @db.VarChar(20)
  managerId         String?
  // 钉钉同步字段
  dingtalkDeptId    Int?                 @unique
  dingtalkParentId  Int?
  createDeptGroup   Boolean              @default(false)
  autoAddUser       Boolean              @default(false)
  lastSyncAt        DateTime?
  // 审计字段
  createdAt         DateTime             @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime             @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int                  @default(1)
  // 关联
  parent            Department?          @relation("DepartmentTree", fields: [parentId], references: [id])
  children          Department[]         @relation("DepartmentTree")
  manager           Employee?            @relation("DepartmentManager", fields: [managerId], references: [id])
  employees         EmployeeDepartment[]
  payrollRecords    PayrollRecord[]
  creatorEmployee   Employee?            @relation("DepartmentCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee   Employee?            @relation("DepartmentUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([managerId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("departments")
  @@schema("public")
}

/// 员工-部门关联（多对多）
model EmployeeDepartment {
  id                String     @id @default(uuid())
  employeeId        String
  departmentId      String
  isPrimary         Boolean    @default(false)
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  creatorEmployeeId String?
  // 关联
  employee          Employee   @relation("EmployeeDepartmentMember", fields: [employeeId], references: [id], onDelete: Cascade)
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  creatorEmployee   Employee?  @relation("EmployeeDepartmentCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)

  @@unique([employeeId, departmentId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([creatorEmployeeId])
  @@map("employee_departments")
  @@schema("public")
}

// ============ CRM 模型 ============

/// 客户
model Customer {
  id                      String        @id @default(uuid())
  yccrmId                 String?       @unique @db.VarChar(100)
  serialNumber            String        @unique @db.VarChar(32)
  customerName            String        @db.VarChar(200)
  shortName               String?       @db.VarChar(100)
  industry                String?       @db.VarChar(100)
  customerLevel           String?       @db.VarChar(50)
  customerSource          String?       @db.VarChar(50)
  customerRelationship    String?       @db.VarChar(50)
  customerTags            Json?
  // 地址
  country                 String?       @db.VarChar(50)
  province                String?       @db.VarChar(50)
  city                    String?       @db.VarChar(50)
  district                String?       @db.VarChar(50)
  address                 String?
  remark                  String?
  aiInfoSummary           String?
  aiInfoGeneratedAt       DateTime?
  // 组织信息
  organizationId          String?       @db.VarChar(100)
  uncId                   String?       @db.VarChar(50)
  headcountRange          String?       @db.VarChar(50)
  // 负责人
  chargerId               String?
  chargerName             String?       @db.VarChar(50)
  charger                 Employee?     @relation("CustomerCharger", fields: [chargerId], references: [id])
  collaboratorName        String?
  collaboratorIds         Json?         @db.JsonB
  // 跟进状态
  contactStatus           String?       @db.VarChar(50)
  dealStatus              String?       @db.VarChar(50)
  lastKeepRecordTime      DateTime?
  lastKeepRecordContent   String?
  // 线索阶段（MQL/SQL）—— 电销跟踪线索质量
  leadStage               String?       @db.VarChar(10)
  leadStageUpdatedAt      DateTime?
  leadStageUpdatedById    String? // 最近一次操作人 employeeId
  leadStageQualifiedById  String? // 合格判定人 employeeId（可能 ≠ 操作人）
  leadStageQualifiedAt    DateTime?
  // 首次进入 MQL/SQL 时间（write-once，永不覆盖；用于 cohort 漏斗分析，避免 leadStageUpdatedAt 因回归/重升被覆盖丢失"第一次"语义）
  firstMqlAt              DateTime?
  firstSqlAt              DateTime?
  leadStageUpdatedBy      Employee?     @relation("CustomerLeadStageUpdater", fields: [leadStageUpdatedById], references: [id], onDelete: SetNull)
  leadStageQualifiedBy    Employee?     @relation("CustomerLeadStageQualifier", fields: [leadStageQualifiedById], references: [id], onDelete: SetNull)
  // Leads 推进状态：与 MQL/SQL 阶段分离，承载下一步行动及预约时间
  leadProgressStatus      String?       @db.VarChar(30)
  leadAppointmentAt       DateTime?
  leadProgressReason      String?
  leadProgressUpdatedAt   DateTime?
  leadProgressUpdatedById String?
  leadProgressUpdatedBy   Employee?     @relation("CustomerLeadProgressUpdater", fields: [leadProgressUpdatedById], references: [id], onDelete: SetNull)
  // 意向信息仅由最近一条填写了意向温度的跟进记录同步，供列表筛选与回访排序。
  intentTemperature       String        @default("UNJUDGED") @db.VarChar(20)
  intentReasons           Json?
  nextFollowUpAt          DateTime?    @db.Date
  intentUpdatedAt         DateTime?
  intentUpdatedById       String?
  intentSourceKeepRecordId String?
  leadValidity            String        @default("VALID") @db.VarChar(20)
  leadInvalidReason       String?       @db.VarChar(30)
  // 财务概要
  /// @precision Decimal
  accountsReceivable      Decimal?      @db.Decimal(12, 2)
  // 状态
  flowStatus              String?       @db.VarChar(50)
  status                  String        @default("active") @db.VarChar(20)
  // 审计
  createdAt               DateTime      @default(now())
  /// 客户页「最近修改」；8 类关联业务对象的聚合更新时间由 20260723100000 migration 的数据库触发器维护。
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?
  version                 Int           @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId       String?
  updaterEmployeeId       String?
  creator                 Employee?     @relation("CustomerCreator", fields: [creatorEmployeeId], references: [id])
  updater                 Employee?     @relation("CustomerUpdater", fields: [updaterEmployeeId], references: [id])
  // 关联
  contacts                Contact[]
  opportunities           Opportunity[]
  saleOrders              SaleOrder[]
  payments                Payment[]
  invoices                Invoice[]
  keepRecords             KeepRecord[]
  visitRecords            VisitRecord[]
  projects                Project[]

  @@index([chargerId])
  @@index([status])
  @@index([customerLevel])
  @@index([customerSource])
  @@index([contactStatus])
  @@index([dealStatus])
  @@index([industry])
  @@index([customerRelationship])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([accountsReceivable])
  @@index([chargerId, deletedAt, createdAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@index([leadStage])
  @@index([leadStage, leadStageUpdatedAt])
  @@index([leadStageUpdatedById])
  @@index([leadStageQualifiedById])
  @@index([firstMqlAt])
  @@index([firstSqlAt])
  @@index([leadProgressStatus])
  @@index([leadAppointmentAt])
  @@index([leadProgressUpdatedById])
  @@index([intentTemperature])
  @@index([nextFollowUpAt])
  @@index([leadValidity])
  @@index([intentUpdatedById])
  @@map("customers")
  @@schema("public")
}

/// 联系人
model Contact {
  id                String        @id @default(uuid())
  yccrmId           String?       @unique @db.VarChar(100)
  contactName       String        @db.VarChar(100)
  customerId        String
  sex               String?       @db.VarChar(10)
  mobile            String?       @db.VarChar(50)
  phone             String?       @db.VarChar(50)
  email             String?       @db.VarChar(100)
  wechat            String?       @db.VarChar(100)
  position          String?       @db.VarChar(100)
  department        String?       @db.VarChar(100)
  // KP 标记（2026-06-20 治理引入）：用于筛选"关键决策人"
  //   - isKp: 是否 KP（人工标记，默认 false）
  //   - kpRole: 决策角色（拍板/技术守门/财务守门/影响人/其他），可空，仅 isKp=true 时填
  // 业务背景：CRM 缺乏 KP 维度可观测性，联系人数量增大后无法快速筛"找谁能拍板"。
  // 字段填充策略：纯人工输入，无派生逻辑——销售在联系人详情勾选
  isKp              Boolean       @default(false)
  kpRole            String?       @db.VarChar(50)
  remark            String?
  flowStatus        String?       @db.VarChar(50)
  status            String        @default("active") @db.VarChar(20)
  // 审计
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId String?
  updaterEmployeeId String?
  creator           Employee?     @relation("ContactCreator", fields: [creatorEmployeeId], references: [id])
  updater           Employee?     @relation("ContactUpdater", fields: [updaterEmployeeId], references: [id])
  // 关联
  customer          Customer      @relation(fields: [customerId], references: [id])
  opportunities     Opportunity[]
  keepRecords       KeepRecord[]
  visitRecords      VisitRecord[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([customerId, deletedAt, createdAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@index([isKp, customerId])
  @@map("contacts")
  @@schema("public")
}

/// 商机
model Opportunity {
  id                        String               @id @default(uuid())
  yccrmId                   String?              @unique @db.VarChar(100)
  serialNumber              String               @unique @db.VarChar(32)
  opportunityName           String               @db.VarChar(200)
  customerId                String
  contactId                 String?
  contact                   Contact?             @relation(fields: [contactId], references: [id])
  opportunityStage          String?              @db.VarChar(50)
  /// @precision Decimal
  opportunityAmount         Decimal?             @db.Decimal(12, 2)
  /// @precision Decimal
  winRate                   Decimal?             @db.Decimal(5, 2)
  expectedDealDate          DateTime?
  realDealDate              DateTime?
  /// 输单流失日期。stage 切到「输单流失」且原值为空时自动填当前时间。
  lostDate                  DateTime?
  chargerId                 String?
  chargerName               String?              @db.VarChar(50)
  charger                   Employee?            @relation("OpportunityCharger", fields: [chargerId], references: [id])
  loseReason                String?
  /// 失单原因备注（当 loseReason='其他' 时承载自由文本说明；历史脏数据迁移到此字段）
  loseReasonDetail          String?
  remark                    String?
  /// WON 来源：manual=人工确认，sale_order=有效订单派生；NULL 为历史未知，按不破坏数据处理。
  wonSourceType             String?              @db.VarChar(20)
  /// 订单派生 WON 当前归属的来源订单；仅作 provenance 快照，不建立强 FK。
  wonSourceSaleOrderId      String?
  /// 首次由订单推到 WON 前的阶段/成交日/赢单率，用于最后一份来源订单失效时精确恢复。
  wonSourcePreviousStage    String?              @db.VarChar(50)
  wonSourcePreviousDealDate DateTime?
  wonSourcePreviousWinRate  Decimal?             @db.Decimal(5, 2)
  flowStatus                String?              @db.VarChar(50)
  status                    String               @default("active") @db.VarChar(20)
  // 审计
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?
  version                   Int                  @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId         String?
  updaterEmployeeId         String?
  creator                   Employee?            @relation("OpportunityCreator", fields: [creatorEmployeeId], references: [id])
  updater                   Employee?            @relation("OpportunityUpdater", fields: [updaterEmployeeId], references: [id])
  // 关联
  customer                  Customer             @relation(fields: [customerId], references: [id])
  /// 2026-07-21 起业务上最多一份有效订单；历史一对多保留，由 migration trigger 约束今后写入。
  saleOrders                SaleOrder[]
  products                  OpportunityProduct[]
  project                   Project?

  @@index([customerId])
  @@index([contactId])
  @@index([chargerId])
  @@index([status])
  @@index([opportunityStage])
  @@index([expectedDealDate])
  @@index([realDealDate])
  @@index([lostDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([opportunityAmount])
  @@index([chargerId, deletedAt, createdAt])
  @@index([customerId, deletedAt, createdAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("opportunities")
  @@schema("public")
}

/// 合同订单
model SaleOrder {
  id                 String             @id @default(uuid())
  yccrmId            String?            @unique @db.VarChar(100)
  serialNumber       String             @unique @db.VarChar(32)
  orderTitle         String?            @db.VarChar(200)
  customerId         String
  opportunityId      String?
  /// @precision Decimal
  orderAmount        Decimal?           @db.Decimal(12, 2)
  /// 其他相关费用（YCCRM 历史字段 sale_order_amount_0，AMOUNT 类型自定义字段） @precision Decimal
  otherFee           Decimal?           @db.Decimal(12, 2)
  /// 坏账金额：核销未收余额，不计入实际回款 @precision Decimal
  badDebtAmount      Decimal            @default(0) @db.Decimal(12, 2)
  /// @precision Decimal
  productAmount      Decimal?           @db.Decimal(12, 2)
  /// @precision Decimal
  totalReceivables   Decimal?           @db.Decimal(12, 2)
  /// @precision Decimal
  totalReceived      Decimal?           @db.Decimal(12, 2)
  /// 已退款总额：SUM(Payment WHERE direction='OUT' AND legacyAdjustment=false AND flowStatus='approved') @precision Decimal
  totalRefunded      Decimal            @default(0) @db.Decimal(12, 2)
  /// @precision Decimal
  totalUncollected   Decimal?           @db.Decimal(12, 2)
  /// 已开票金额：sum(invoice.invoiceAmount) where flowStatus='approved' AND status='active'
  /// @precision Decimal
  invoicedAmount     Decimal            @default(0) @db.Decimal(12, 2)
  /// 订单维度的开票状态：未开票 / 部分开票 / 已开完（与 Invoice.invoiceStatus 的"正常/作废"是不同维度）
  orderInvoiceStatus String?            @db.VarChar(50)
  orderStatus        String?            @db.VarChar(50)
  /// 历史负向订单标识；仅由受控治理迁移写入，普通创建/编辑接口不可写
  legacyAdjustment   Boolean            @default(false)
  businessDate       DateTime?
  paymentDate        DateTime?
  /// 最近回款日期：MAX(Payment.businessDate WHERE direction='IN' AND flowStatus='approved')，
  /// 由 payment-summary.helper 派生维护（与 totalReceived 同口径）；与手工录入的 paymentDate（回款时间）语义不同
  lastPaymentDate    DateTime?
  orderBeginDate     DateTime?
  orderEndDate       DateTime?
  chargerId          String?
  chargerName        String?            @db.VarChar(50)
  charger            Employee?          @relation("SaleOrderCharger", fields: [chargerId], references: [id])
  remark             String?
  flowStatus         String?            @db.VarChar(50)
  status             String             @default("active") @db.VarChar(20)
  // 审计
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  version            Int                @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId  String?
  updaterEmployeeId  String?
  creator            Employee?          @relation("SaleOrderCreator", fields: [creatorEmployeeId], references: [id])
  updater            Employee?          @relation("SaleOrderUpdater", fields: [updaterEmployeeId], references: [id])
  // 关联
  customer           Customer           @relation(fields: [customerId], references: [id])
  opportunity        Opportunity?       @relation(fields: [opportunityId], references: [id])
  payments           Payment[]
  invoices           Invoice[]
  products           OrderProduct[]
  projectLinks       ProjectSaleOrder[]
  project            Project?           @relation("ProjectPrimarySaleOrder")
  financeLedgers     FinanceLedger[]    @relation("FinanceLedgerSaleOrder")

  @@index([customerId])
  @@index([opportunityId])
  @@index([chargerId])
  @@index([status])
  @@index([orderStatus])
  @@index([businessDate])
  @@index([paymentDate])
  @@index([lastPaymentDate])
  @@index([orderBeginDate])
  @@index([orderEndDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([orderAmount])
  @@index([invoicedAmount])
  @@index([orderInvoiceStatus])
  @@index([chargerId, deletedAt, createdAt])
  @@index([customerId, deletedAt, createdAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("sale_orders")
  @@schema("public")
}

/// 回款 / 退款
/// direction='IN'  → 回款（PAY-xxxxx）
/// direction='OUT' → 退款（REF-xxxxx），必须关联一笔已 approved 的 IN 回款（relatedPaymentId）
model Payment {
  id                  String          @id @default(uuid())
  yccrmId             String?         @unique @db.VarChar(100)
  serialNumber        String          @unique @db.VarChar(32)
  /// 业务摘要（首期款/进度款/尾款/质保金返还/年费续费/月度服务费/培训费/硬件款/一次性买断/客户退款/...）
  /// 实体显示名统一规约的派生主源（getEntityDisplayName('payment', e, 'short'/'long'/'withContext')）
  subject             String          @db.VarChar(100)
  saleOrderId         String
  customerId          String
  /// @precision Decimal
  paymentAmount       Decimal         @db.Decimal(12, 2)
  paymentType         String?         @db.VarChar(50)
  businessDate        DateTime?
  payer               String?         @db.VarChar(100)
  bankName            String?         @db.VarChar(100)
  tradeSerialNumber   String?         @db.VarChar(100)
  chargerId           String?
  chargerName         String?         @db.VarChar(50)
  charger             Employee?       @relation("PaymentCharger", fields: [chargerId], references: [id])
  remark              String?
  flowStatus          String?         @db.VarChar(50)
  status              String          @default("active") @db.VarChar(20)
  /// 资金流方向：IN=回款 / OUT=退款或历史负向调整。历史数据默认 IN；审批通过后不可修改
  direction           String          @default("IN") @db.VarChar(10)
  /// YCCRM 历史负数订单对应的负向调整；仅治理程序可写，不能由业务接口创建
  legacyAdjustment    Boolean         @default(false)
  /// 退款类型（普通 direction='OUT' 时必填），取自 PAYMENT_REFUND_TYPE 枚举
  refundType          String?         @db.VarChar(50)
  /// 退款原因自由文本（direction='OUT' 时可选）
  refundReason        String?
  /// 关联的原回款 ID（普通 direction='OUT' 退款必填；legacyAdjustment=true 时必须为空）
  relatedPaymentId    String?
  relatedPayment      Payment?        @relation("PaymentRefund", fields: [relatedPaymentId], references: [id])
  refundedBy          Payment[]       @relation("PaymentRefund")
  /// 关联的红字发票 ID（direction='OUT' 时可选），用于已开票退款场景的对账
  relatedInvoiceId    String?
  relatedInvoice      Invoice?        @relation("PaymentInvoiceRef", fields: [relatedInvoiceId], references: [id])
  /// 合并开票来源回款 → 此回款被合并到的发票 ID（v1 单向反向引用，便于在回款列表显示"已合并到发票 X"绿勾）。仅 direction='IN' 时使用；发票被驳回/撤回/软删时回置 null
  invoicedByInvoiceId String?
  invoicedByInvoice   Invoice?        @relation("PaymentInvoicedBy", fields: [invoicedByInvoiceId], references: [id])
  /// 财务收款账户（指向 finance_accounts）—— Payment 通过 service 层兜底必填；2026-06 「CRM 回款 ↔ 财务流水绑定方案 v2.1」引入
  financeAccountId    String?
  financeAccount      FinanceAccount? @relation("PaymentFinanceAccount", fields: [financeAccountId], references: [id], onDelete: Restrict)
  /// 财务入账科目（指向 finance_subjects）—— 可选覆盖；为空时同步钩子用 non_pl.uncategorized 兜底，由 admin 在 finance-ledger 批量改科目
  financeSubjectId    String?
  financeSubject      FinanceSubject? @relation("PaymentFinanceSubject", fields: [financeSubjectId], references: [id], onDelete: Restrict)
  /// 反向 1:N（v2.1→v2.2 调整）：派生的财务流水
  /// v2.1 是 1:1，v2.2 改为 1:N（同 payment 多 PaymentItem 各派生一条 ledger，merge_with 场景）
  financeLedgers      FinanceLedger[] @relation("FinanceLedgerPayment")
  /// 反向 1:N（v2.2 新增）：PaymentItem 子项（一笔 payment 可拆 N 个产品 × N 个科目 × N 个 mode）
  paymentItems        PaymentItem[]
  // 审计
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  version             Int             @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId   String?
  updaterEmployeeId   String?
  creator             Employee?       @relation("PaymentCreator", fields: [creatorEmployeeId], references: [id])
  updater             Employee?       @relation("PaymentUpdater", fields: [updaterEmployeeId], references: [id])
  // 关联
  saleOrder           SaleOrder       @relation(fields: [saleOrderId], references: [id])
  customer            Customer        @relation(fields: [customerId], references: [id])

  @@index([saleOrderId])
  @@index([customerId])
  @@index([chargerId])
  @@index([status])
  @@index([paymentType])
  @@index([businessDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([paymentAmount])
  @@index([chargerId, deletedAt, createdAt])
  @@index([customerId, deletedAt, createdAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@index([direction, flowStatus, deletedAt])
  @@index([relatedPaymentId])
  @@index([relatedInvoiceId])
  @@index([invoicedByInvoiceId])
  @@index([financeAccountId])
  @@index([financeSubjectId])
  @@map("payments")
  @@schema("public")
}

/// CRM 回款子项（绑定方案 v2.2 新增）
/// 一笔 payment 拆 N 个 PaymentItem，每行 = 一个产品 × 金额 × 财务科目 × 收款模式
/// 同步钩子按 PaymentItem 派生 N 条 FinanceLedger（dingtalk_collect / pass_through_cost 跳过）
/// 强引用 OrderProduct：v2.2 Phase 1 落字段时 saleOrderProductId 允许 NULL（历史回填窗口），
/// Phase 11 完成后单独 migration 加 NOT NULL constraint
model PaymentItem {
  id                 String          @id @default(uuid())
  paymentId          String
  /// onDelete: Restrict（业务实体走 deletedAt 软删，禁止硬删）
  payment            Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// 强引用：指向 OrderProduct.id（v2.2 Phase 11 已收紧为 NOT NULL）
  saleOrderProductId String
  orderProduct       OrderProduct    @relation(fields: [saleOrderProductId], references: [id], onDelete: Restrict)
  /// 同 payment 下 item 序号（1-based，便于 UI 排序）
  itemSeq            Int             @default(1)
  /// 产品名快照（兼容历史 ledger.remark 拆出的 220 条无法 100% 精确定位的）
  productName        String          @db.VarChar(200)
  /// 此 item 的金额（Σ pi.amount where paymentId=p.id 应等于 p.paymentAmount）
  /// @precision Decimal
  amount             Decimal         @db.Decimal(12, 2)
  /// 财务科目（默认从 OrderProduct.financeSubjectId 继承，admin 可手工调整）
  financeSubjectId   String?
  financeSubject     FinanceSubject? @relation("PaymentItemFinanceSubject", fields: [financeSubjectId], references: [id], onDelete: SetNull)
  /// 收款模式（默认从 OrderProduct.paymentMode 继承）
  /// direct: 派生 ledger 进 P&L 进账户
  /// dingtalk_collect: 钉钉天元代收，跳过 ledger 派生（佣金月结独立挂账）
  /// pass_through: 过单实收部分，派生 ledger 进 P&L 进账户
  /// pass_through_cost: 过单代付成本，跳过 ledger 派生（管理员手工录入代付成本）
  paymentMode        String          @default("direct") @db.VarChar(20)
  remark             String?
  /// 反向 1:1：派生的财务流水（mode=direct/pass_through 时存在）
  financeLedger      FinanceLedger?  @relation("FinanceLedgerPaymentItem")
  // 审计
  createdAt          DateTime        @default(now())
  creatorEmployeeId  String?
  updatedAt          DateTime        @updatedAt
  updaterEmployeeId  String?
  deletedAt          DateTime?
  version            Int             @default(1)
  creator            Employee?       @relation("PaymentItemCreator", fields: [creatorEmployeeId], references: [id])
  updater            Employee?       @relation("PaymentItemUpdater", fields: [updaterEmployeeId], references: [id])

  @@unique([paymentId, itemSeq])
  @@index([paymentId])
  @@index([saleOrderProductId])
  @@index([financeSubjectId])
  @@index([paymentMode])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("payment_items")
  @@schema("public")
}

/// 开票
model Invoice {
  id                String    @id @default(uuid())
  yccrmId           String?   @unique @db.VarChar(100)
  serialNumber      String    @unique @db.VarChar(32)
  /// 开票业务摘要（软件开发服务费/技术服务费/钉钉软件费/钉钉硬件款/培训费/咨询服务费/年度授权费/维护服务费/...）
  /// 实体显示名统一规约的派生主源；注意区别于 `title` 字段（那是"发票抬头"=客户公司名）
  subject           String    @db.VarChar(100)
  saleOrderId       String
  customerId        String
  /// @precision Decimal
  invoiceAmount     Decimal   @db.Decimal(12, 2)
  invoiceType       String?   @db.VarChar(50)
  invoiceDate       DateTime?
  invoiceNumber     String?   @db.VarChar(100)
  title             String?   @db.VarChar(200)
  taxIdentifyNum    String?   @db.VarChar(50)
  invoiceStatus     String?   @db.VarChar(50)
  itemType          String?   @db.VarChar(50)
  bankName          String?   @db.VarChar(200)
  bankAccount       String?   @db.VarChar(100)
  registeredAddress String?   @db.VarChar(500)
  registeredPhone   String?   @db.VarChar(50)
  chargerId         String?
  chargerName       String?   @db.VarChar(50)
  charger           Employee? @relation("InvoiceCharger", fields: [chargerId], references: [id])
  /// 合并开票来源回款 ID 数组（v1 单向引用；合并出来的发票必须满足同 customerId + 同 saleOrderId + 全 IN + 已审批通过 + 未合并过）
  sourcePaymentIds  Json?
  remark            String?
  flowStatus        String?   @db.VarChar(50)
  status            String    @default("active") @db.VarChar(20)
  // 审计
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  version           Int       @default(1)
  // 创建/修改人（yccrm 同步从 raw creator_id/changer_id 反查为 employee.id）
  creatorEmployeeId String?
  updaterEmployeeId String?
  creator           Employee? @relation("InvoiceCreator", fields: [creatorEmployeeId], references: [id])
  updater           Employee? @relation("InvoiceUpdater", fields: [updaterEmployeeId], references: [id])
  // 关联
  saleOrder         SaleOrder @relation(fields: [saleOrderId], references: [id])
  customer          Customer  @relation(fields: [customerId], references: [id])
  /// 反向关系：所有引用此发票（作为红字冲销标记）的退款 Payment
  refundedPayments  Payment[] @relation("PaymentInvoiceRef")
  /// 反向关系：所有被合并开到此发票的回款 Payment（v1 合并开票来源回查）
  mergedPayments    Payment[] @relation("PaymentInvoicedBy")

  @@index([saleOrderId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceStatus])
  @@index([invoiceType])
  @@index([itemType])
  @@index([invoiceDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([invoiceAmount])
  @@index([customerId, deletedAt, createdAt])
  @@index([chargerId])
  @@index([chargerId, deletedAt, createdAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("invoices")
  @@schema("public")
}

