  statDate            DateTime @db.Date
  level               String   @db.VarChar(20)
  entityId            String   @db.VarChar(128)
  entityName          String?  @db.VarChar(300)
  campaignId          String?  @db.VarChar(128)
  campaignName        String?  @db.VarChar(300)
  unitId              String?  @db.VarChar(128)
  unitName            String?  @db.VarChar(300)
  creativeId          String?  @db.VarChar(128)
  creativeName        String?  @db.VarChar(300)
  /// @precision Decimal
  fee                 Decimal  @default(0) @db.Decimal(18, 2)
  impression          Int      @default(0)
  click               Int      @default(0)
  interaction         Int      @default(0)
  like                Int      @default(0)
  comment             Int      @default(0)
  collect             Int      @default(0)
  follow              Int      @default(0)
  share               Int      @default(0)
  landingPageVisit    Int?
  formImpression      Int?
  formSubmit          Int?
  validFormSubmit     Int?
  combinedLead        Int?
  messageUser         Int?
  messageConsult      Int?
  messageOpen         Int?
  messageLead         Int?
  /// @precision Decimal
