  @@map("xiaohongshu_sync_runs")
  @@schema("public")
}

// ========================================
// 财务模块（finance）
// 可见性由 RolePermission.finance.* 决定，不再按超管身份硬编码
// 来源：外部回款表明细流水迁移（工作簿标识由安装方配置，不写入源码）
// ========================================

/// 财务账户字典（招行 / 支付宝 / 兴业 / 微信 / 现金）
model FinanceAccount {
  id                String    @id @default(uuid())
  /// 程序内引用键：cmb / alipay / cib / wechat / cash
  code              String    @unique @db.VarChar(40)
  /// 显示名：招商银行 / 支付宝 / ...
  name              String    @db.VarChar(50)
  /// 账户类型：bank / alipay / wechat / cash
  kind              String    @db.VarChar(20)
  /// 币种，预留多币种扩展
  currency          String    @default("CNY") @db.VarChar(10)
  /// 期初余额（2025-01-01 之前的余额）
  /// @precision Decimal
  openingBalance    Decimal   @default(0) @db.Decimal(16, 2)
  displayOrder      Int       @default(0)
  status            String    @default("active") @db.VarChar(20)
  remark            String?
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  ledgers         FinanceLedger[]
  personalLedgers FinancePersonalLedger[]
  /// 反向 1:N：被 CRM 回款选作收款账户（绑定方案 v2.1）
  payments        Payment[]               @relation("PaymentFinanceAccount")
  creatorEmployee Employee?               @relation("FinanceAccountCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?               @relation("FinanceAccountUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([deletedAt, displayOrder])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("finance_accounts")
  @@schema("public")
}

/// 财务科目字典（P&L 树）
/// level=1 是分组节点（不可挂账），level=2 是叶子（可挂账）
/// category：revenue / cogs / opex / tax / other_income / non_pl
model FinanceSubject {
  id                String    @id @default(uuid())
  /// 程序内引用键：revenue.dingtalk_resale / opex.ga_office / ...
  code              String    @unique @db.VarChar(60)
  /// 中文显示名（importer 用 name 匹配钉钉 B 列科目字符串）
  name              String    @unique @db.VarChar(80)
  /// 大类：revenue / cogs / opex / tax / other_income / non_pl
  category          String    @db.VarChar(20)
  /// 1=分组（不可挂账） / 2=叶子（可挂账）
  level             Int       @default(2)
  /// 自关联，level=2 必须有 parentId，level=1 可以有也可以无
  parentId          String?
  displayOrder      Int       @default(0)
  status            String    @default("active") @db.VarChar(20)
  remark            String?
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  parent             FinanceSubject?         @relation("FinanceSubjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           FinanceSubject[]        @relation("FinanceSubjectTree")
  ledgers            FinanceLedger[]
  personalLedgers    FinancePersonalLedger[]
  /// 反向 1:N：被 CRM 回款选作入账科目（绑定方案 v2.1）
  payments           Payment[]               @relation("PaymentFinanceSubject")
  /// 反向 1:N：被 CrmProduct 选作默认科目（绑定方案 v2.2）
  crmProductDefaults CrmProduct[]            @relation("CrmProductDefaultSubject")
  /// 反向 1:N：被 OrderProduct 选作产品行级科目（绑定方案 v2.2）
  orderProducts      OrderProduct[]          @relation("OrderProductFinanceSubject")
  /// 反向 1:N：被 PaymentItem 选作入账科目（绑定方案 v2.2，真 1:N 主轴）
  paymentItems       PaymentItem[]           @relation("PaymentItemFinanceSubject")
  creatorEmployee    Employee?               @relation("FinanceSubjectCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee    Employee?               @relation("FinanceSubjectUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([category, displayOrder])
  @@index([deletedAt])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("finance_subjects")
  @@schema("public")
}

/// 财务流水（公司账主表，不含「个人」）
/// runningBalance 不存储，列表查询时由 SQL `SUM() OVER (PARTITION BY account_id ORDER BY tx_date, id)` 派生
model FinanceLedger {
  id                String    @id @default(uuid())
  /// A 列：交易日期
  txDate            DateTime  @db.Date
  accountId         String
  subjectId         String
  /// D 列：金额（正=收入，负=支出）
  /// @precision Decimal
  amount            Decimal   @db.Decimal(16, 2)
  /// 'in' / 'out'，由 amount 符号派生但冗余存储便于过滤
  direction         String    @db.VarChar(4)
  /// C 列：备注
  remark            String?
  // 钉钉迁移痕迹（手工新增的流水可不写）
  /// 'dingtalk_import' / 'manual'
  source            String    @default("manual") @db.VarChar(20)
  dingtalkSheetName String?   @db.VarChar(50)
  dingtalkRowIndex  Int?
  /// SHA-256(sheetName|rowIndex|txDate|amount|remark)，防重幂等
  dingtalkRowHash   String?   @unique @db.VarChar(64)
  // 软关联（预留）
  saleOrderId       String?
  payrollRecordId   String?
  /// CRM 回款绑定（v2.1 1:1，v2.2 调整为 1:N 索引）：保留作为回款溯源索引，但允许同 payment 拆 N 条 ledger（merge_with 场景）
  paymentId         String?
  /// CRM 回款绑定（绑定方案 v2.2 新增）：派生 ledger 必填此字段（v2.2 同步钩子按 PaymentItem 派生）
  /// 1:1 强约束改挂到 PaymentItem 层；手工/钉钉导入流水为 null
  paymentItemId     String?   @unique
  importBatchId     String?
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  account         FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  subject         FinanceSubject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  saleOrder       SaleOrder?          @relation("FinanceLedgerSaleOrder", fields: [saleOrderId], references: [id], onDelete: SetNull)
  payrollRecord   PayrollRecord?      @relation("FinanceLedgerPayrollRecord", fields: [payrollRecordId], references: [id], onDelete: SetNull)
  /// CRM 回款绑定的源 Payment（绑定方案 v2.1 1:1 索引，v2.2 改 1:N 索引保留作回款溯源）
  payment         Payment?            @relation("FinanceLedgerPayment", fields: [paymentId], references: [id], onDelete: SetNull)
  /// CRM 回款绑定的源 PaymentItem（绑定方案 v2.2，真 1:1 主轴）
  paymentItem     PaymentItem?        @relation("FinanceLedgerPaymentItem", fields: [paymentItemId], references: [id], onDelete: SetNull)
  importBatch     FinanceImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  creatorEmployee Employee?           @relation("FinanceLedgerCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?           @relation("FinanceLedgerUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([txDate, accountId])
  @@index([accountId, txDate])
  @@index([subjectId, txDate])
  @@index([deletedAt, txDate])
  @@index([importBatchId])
  @@index([saleOrderId])
  @@index([payrollRecordId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@index([paymentId])
  @@map("finance_ledgers")
  @@schema("public")
}

/// 私账流水（独立物理表，与 FinanceLedger 字段对齐但无 saleOrderId/payrollRecordId）
/// 物理隔离 = 权限隔离 = 误查零风险
model FinancePersonalLedger {
  id                String    @id @default(uuid())
  txDate            DateTime  @db.Date
  accountId         String
  subjectId         String
  /// @precision Decimal
  amount            Decimal   @db.Decimal(16, 2)
  direction         String    @db.VarChar(4)
  remark            String?
  source            String    @default("manual") @db.VarChar(20)
  dingtalkSheetName String?   @db.VarChar(50)
  dingtalkRowIndex  Int?
  dingtalkRowHash   String?   @unique @db.VarChar(64)
  importBatchId     String?
  createdAt         DateTime  @default(now())
  creatorEmployeeId String?
  updatedAt         DateTime  @updatedAt
  updaterEmployeeId String?
  deletedAt         DateTime?
  version           Int       @default(1)

  account         FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  subject         FinanceSubject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  importBatch     FinanceImportBatch? @relation("FinancePersonalLedgerImportBatch", fields: [importBatchId], references: [id], onDelete: SetNull)
  creatorEmployee Employee?           @relation("FinancePersonalLedgerCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?           @relation("FinancePersonalLedgerUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([txDate, accountId])
  @@index([accountId, txDate])
  @@index([subjectId, txDate])
  @@index([deletedAt, txDate])
  @@index([importBatchId])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("finance_personal_ledgers")
  @@schema("public")
}

/// 财务导入批次（外部回款表表迁移用）
model FinanceImportBatch {
  id                 String    @id @default(uuid())
  /// 'dingtalk' / 'manual'
  source             String    @default("dingtalk") @db.VarChar(20)
  workbookId         String?   @db.VarChar(64)
  /// 解析了哪些 sheet（如 ['2025','2026']）
  sheetNames         String[]
  totalRows          Int       @default(0)
  successRows        Int       @default(0)
  skippedRows        Int       @default(0)
  failedRows         Int       @default(0)
  /// 分流到私账表的行数
  personalRows       Int       @default(0)
  /// 'preview' / 'committed' / 'failed'
  status             String    @default("pending") @db.VarChar(20)
  /// preview 阶段持久化的解析结果，commit 阶段反序列化重放（避免重新调 dws）
  previewJson        Json?
  summaryJson        Json?
  errorReportJson    Json?
  /// 双对账结果：balanceDiffs + pnlDiffs + passed
  reconciliationJson Json?
  createdAt          DateTime  @default(now())
  creatorEmployeeId  String?
  updatedAt          DateTime  @updatedAt
  updaterEmployeeId  String?
  deletedAt          DateTime?
  version            Int       @default(1)

  ledgers         FinanceLedger[]
  personalLedgers FinancePersonalLedger[] @relation("FinancePersonalLedgerImportBatch")
  creatorEmployee Employee?               @relation("FinanceImportBatchCreator", fields: [creatorEmployeeId], references: [id], onDelete: SetNull)
  updaterEmployee Employee?               @relation("FinanceImportBatchUpdater", fields: [updaterEmployeeId], references: [id], onDelete: SetNull)

  @@index([deletedAt, createdAt])
  @@index([status])
  @@index([creatorEmployeeId])
  @@index([updaterEmployeeId])
  @@map("finance_import_batches")
  @@schema("public")
}

/// 官网第一方埋点事件
/// 写入由独立 collector（独立 analytics collector）直连 PG 完成，
/// azeroth 只通过本 model 做只读查询 + 归档（findMany / findFirst / count /
/// deleteMany / groupBy / aggregate）。
///
/// 关键：分区表（PARTITION BY RANGE(received_at)），复合主键 (id, received_at)。
/// Prisma 不参与该表的 DDL 维护（CREATE/DROP PARTITION 由 collector 管）。
///
/// **写入禁用**：不要调 `prisma.webEvent.create() / createMany() / update() /
/// updateMany() / upsert()`！collector 单边写入；且 PG 侧 `id` 是 GENERATED
/// ALWAYS AS IDENTITY（不是 Prisma autoincrement 隐含的 BY DEFAULT），显式
/// 赋 id 会被 PG 直接拒。同理禁止在此仓库跑 `prisma db push` / `prisma migrate
/// dev` 试图同步该表——会试图把 ALWAYS 改成 BY DEFAULT（生产 RDS 不会被改，
/// 但本地 dev DB 可能被污染）。
model WebEvent {
  id          BigInt    @default(autoincrement())
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  clientTs    DateTime? @map("client_ts") @db.Timestamptz()
  site        String
  event       String
  vid         String?
  sid         String?
  path        String?
  pageType    String?   @map("page_type")
  title       String?
  referrer    String?
  refHost     String?   @map("ref_host")
  utmSource   String?   @map("utm_source")
  utmMedium   String?   @map("utm_medium")
  utmCampaign String?   @map("utm_campaign")
  utmTerm     String?   @map("utm_term")
  utmContent  String?   @map("utm_content")
  placement   String?
  channel     String?
  label       String?
  ua          String?
  isBot       Boolean   @default(false) @map("is_bot")
  ipHash      String?   @map("ip_hash")
  // IP → 地域反查（collector ip2region 中国本土库解析；ky-azeroth 迁移用 IF NOT EXISTS 对齐 Prisma ledger）。
  // 明文 IP 坚决不下发；只暴露 country/region/city/isp 四粒度供分析用。
  country     String?
  region      String?
  city        String?
  isp         String?
  screen      String?
  lang        String?
  raw         Json?

  @@id([id, receivedAt])
  @@index([receivedAt])
  @@index([event, receivedAt])
  @@index([path, receivedAt])
  @@index([vid, receivedAt])
  @@index([sid, receivedAt])
  @@map("events")
  @@schema("web_analytics")
}
